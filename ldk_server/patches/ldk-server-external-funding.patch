+// Open a channel whose funding output is provided externally (e.g. as an output
+// of a JoinMarket CoinJoin) rather than funded from this node's on-chain wallet.
+message OpenChannelExternalFundingRequest {
+  string node_pubkey = 1;
+  string address = 2;
+  uint64 channel_amount_sats = 3;
+  optional uint64 push_to_counterparty_msat = 4;
+  optional types.ChannelConfig channel_config = 5;
+}
+
+message OpenChannelExternalFundingResponse {
+  // The local channel id used to refer to this externally-funded channel.
+  string user_channel_id = 1;
+}
+
+// Poll for the funding output of an externally-funded channel open.
+message GetFundingOutputRequest {
+  string user_channel_id = 1;
+}
+
+message GetFundingOutputResponse {
+  // True once the channel handshake reached FundingGenerationReady.
+  bool ready = 1;
+  // The hex-encoded funding scriptPubKey to place in the external transaction.
+  string funding_script_pubkey = 2;
+  // The exact value (sats) the funding output must carry.
+  uint64 channel_value_sats = 3;
+}
+
+// Provide the outpoint of the externally-broadcast funding transaction.
+message ProvideFundingOutpointRequest {
+  string user_channel_id = 1;
+  string funding_txid = 2;
+  uint32 funding_vout = 3;
+}
+
+message ProvideFundingOutpointResponse {}
+
 // Increases the channel balance by the given amount.
