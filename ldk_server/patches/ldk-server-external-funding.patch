diff --git a/ldk-server/src/api/open_channel_external_funding.rs b/ldk-server/src/api/open_channel_external_funding.rs
new file mode 100644
index 0000000..4ecca03
--- /dev/null
+++ b/ldk-server/src/api/open_channel_external_funding.rs
@@ -0,0 +1,42 @@
+// Open a channel whose funding output is provided externally (e.g. as an output
+// of a JoinMarket CoinJoin) instead of being funded from this node's wallet.
+
+use std::str::FromStr;
+use std::sync::Arc;
+
+use ldk_node::bitcoin::secp256k1::PublicKey;
+use ldk_node::config::ChannelConfig;
+use ldk_node::lightning::ln::msgs::SocketAddress;
+use ldk_server_grpc::api::{
+	OpenChannelExternalFundingRequest, OpenChannelExternalFundingResponse,
+};
+
+use crate::api::build_channel_config_from_proto;
+use crate::api::error::LdkServerError;
+use crate::service::Context;
+
+pub(crate) async fn handle_open_channel_external_funding(
+	context: Arc<Context>, request: OpenChannelExternalFundingRequest,
+) -> Result<OpenChannelExternalFundingResponse, LdkServerError> {
+	let node_id = PublicKey::from_str(&request.node_pubkey)
+		.map_err(|_| ldk_node::NodeError::InvalidPublicKey)?;
+	let address = SocketAddress::from_str(&request.address)
+		.map_err(|_| ldk_node::NodeError::InvalidSocketAddress)?;
+
+	let channel_config = request
+		.channel_config
+		.map(|proto_config| build_channel_config_from_proto(ChannelConfig::default(), proto_config))
+		.transpose()?;
+
+	let user_channel_id = context.node.open_channel_external_funding(
+		node_id,
+		address,
+		request.channel_amount_sats,
+		request.push_to_counterparty_msat,
+		channel_config,
+	)?;
+
+	Ok(OpenChannelExternalFundingResponse {
+		user_channel_id: user_channel_id.0.to_string(),
+	})
+}
diff --git a/ldk-server/src/api/provide_funding_outpoint.rs b/ldk-server/src/api/provide_funding_outpoint.rs
new file mode 100644
index 0000000..dccbd60
--- /dev/null
+++ b/ldk-server/src/api/provide_funding_outpoint.rs
@@ -0,0 +1,31 @@
+// Provide the outpoint of the externally-broadcast funding transaction so the
+// externally-funded channel open can complete.
+
+use std::str::FromStr;
+use std::sync::Arc;
+
+use ldk_node::bitcoin::Txid;
+use ldk_node::UserChannelId;
+use ldk_server_grpc::api::{ProvideFundingOutpointRequest, ProvideFundingOutpointResponse};
+
+use crate::api::error::{LdkServerError, LdkServerErrorCode};
+use crate::service::Context;
+
+pub(crate) async fn handle_provide_funding_outpoint(
+	context: Arc<Context>, request: ProvideFundingOutpointRequest,
+) -> Result<ProvideFundingOutpointResponse, LdkServerError> {
+	let id: u128 = request.user_channel_id.parse().map_err(|_| {
+		LdkServerError::new(LdkServerErrorCode::InvalidRequestError, "Invalid user_channel_id")
+	})?;
+	let txid = Txid::from_str(&request.funding_txid).map_err(|_| {
+		LdkServerError::new(LdkServerErrorCode::InvalidRequestError, "Invalid funding_txid")
+	})?;
+
+	context.node.provide_funding_outpoint(
+		&UserChannelId(id),
+		txid,
+		request.funding_vout,
+	)?;
+
+	Ok(ProvideFundingOutpointResponse {})
+}
