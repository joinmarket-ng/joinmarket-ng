diff --git a/ldk-server/src/api/get_funding_output.rs b/ldk-server/src/api/get_funding_output.rs
new file mode 100644
index 0000000..8f5b62b
--- /dev/null
+++ b/ldk-server/src/api/get_funding_output.rs
@@ -0,0 +1,30 @@
+// Poll for the funding output of an externally-funded channel open.
+
+use std::sync::Arc;
+
+use ldk_node::UserChannelId;
+use ldk_server_grpc::api::{GetFundingOutputRequest, GetFundingOutputResponse};
+
+use crate::api::error::{LdkServerError, LdkServerErrorCode};
+use crate::service::Context;
+
+pub(crate) async fn handle_get_funding_output(
+	context: Arc<Context>, request: GetFundingOutputRequest,
+) -> Result<GetFundingOutputResponse, LdkServerError> {
+	let id: u128 = request.user_channel_id.parse().map_err(|_| {
+		LdkServerError::new(LdkServerErrorCode::InvalidRequestError, "Invalid user_channel_id")
+	})?;
+
+	match context.node.get_external_funding_output(&UserChannelId(id)) {
+		Some((script, value)) => Ok(GetFundingOutputResponse {
+			ready: true,
+			funding_script_pubkey: script.to_hex_string(),
+			channel_value_sats: value,
+		}),
+		None => Ok(GetFundingOutputResponse {
+			ready: false,
+			funding_script_pubkey: String::new(),
+			channel_value_sats: 0,
+		}),
+	}
+}
