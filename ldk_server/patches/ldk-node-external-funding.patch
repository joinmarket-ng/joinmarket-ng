diff --git a/src/external_funding.rs b/src/external_funding.rs
new file mode 100644
index 0000000..b826261
--- /dev/null
+++ b/src/external_funding.rs
@@ -0,0 +1,40 @@
+// External channel funding (e.g. funding a channel from a JoinMarket CoinJoin
+// output) instead of funding it from this node's on-chain wallet.
+//
+// The application opens a channel with `Node::open_channel_external_funding`,
+// waits (via `Node::get_external_funding_output`) for the channel handshake to
+// reach `FundingGenerationReady`, places the returned funding output in its own
+// transaction (the CoinJoin), broadcasts it, and then calls
+// `Node::provide_funding_outpoint` with the resulting outpoint. Internally this
+// uses LDK's `unsafe_manual_funding_transaction_generated`, so LDK never funds
+// or broadcasts the funding transaction itself.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+
+use bitcoin::secp256k1::PublicKey;
+use bitcoin::ScriptBuf;
+use lightning::ln::types::ChannelId;
+
+/// Per-channel state for an externally-funded channel open.
+#[derive(Clone)]
+pub(crate) enum ExternalFundingState {
+	/// Open initiated; awaiting the `FundingGenerationReady` event.
+	Pending,
+	/// `FundingGenerationReady` fired: the caller may now place `output_script`
+	/// (worth `channel_value_satoshis`) in an external transaction and then
+	/// provide the resulting outpoint via `Node::provide_funding_outpoint`.
+	Ready {
+		temporary_channel_id: ChannelId,
+		counterparty_node_id: PublicKey,
+		output_script: ScriptBuf,
+		channel_value_satoshis: u64,
+	},
+}
+
+/// Map of `UserChannelId` (u128) -> external funding state.
+pub(crate) type ExternalFundingMap = Arc<Mutex<HashMap<u128, ExternalFundingState>>>;
+
+pub(crate) fn new_external_funding_map() -> ExternalFundingMap {
+	Arc::new(Mutex::new(HashMap::new()))
+}
