+	/// Connect to a node and open a channel whose funding output is provided
+	/// *externally* (e.g. as an output of a JoinMarket CoinJoin) rather than
+	/// funded from this node's on-chain wallet.
+	///
+	/// After this returns, poll [`Node::get_external_funding_output`] until it
+	/// yields the funding `scriptPubKey` and value; place that output in your
+	/// own transaction, broadcast it, and then call
+	/// [`Node::provide_funding_outpoint`] with the resulting outpoint. This node
+	/// never funds or broadcasts the funding transaction.
+	pub fn open_channel_external_funding(
+		&self, node_id: PublicKey, address: SocketAddress, channel_amount_sats: u64,
+		push_to_counterparty_msat: Option<u64>, channel_config: Option<ChannelConfig>,
+	) -> Result<UserChannelId, Error> {
+		self.open_channel_inner(
+			node_id,
+			address,
+			FundingAmount::Exact { amount_sats: channel_amount_sats },
+			push_to_counterparty_msat,
+			channel_config,
+			false,
+			false,
+			true,
+		)
+	}
+
+	/// For a channel opened with [`Node::open_channel_external_funding`], return
+	/// the funding output `(scriptPubKey, value_sats)` once the channel handshake
+	/// has reached `FundingGenerationReady`, or `None` if it is not ready yet.
+	pub fn get_external_funding_output(
+		&self, user_channel_id: &UserChannelId,
+	) -> Option<(ScriptBuf, u64)> {
+		match self.external_funding.lock().unwrap().get(&user_channel_id.0) {
+			Some(ExternalFundingState::Ready {
+				output_script, channel_value_satoshis, ..
+			}) => Some((output_script.clone(), *channel_value_satoshis)),
+			_ => None,
+		}
+	}
+
+	/// For a channel opened with [`Node::open_channel_external_funding`], provide
+	/// the outpoint of the (externally broadcast) funding transaction. This drives
+	/// the channel to completion via LDK's manual funding flow.
+	pub fn provide_funding_outpoint(
+		&self, user_channel_id: &UserChannelId, funding_txid: Txid, funding_vout: u32,
+	) -> Result<(), Error> {
+		let entry = self.external_funding.lock().unwrap().get(&user_channel_id.0).cloned();
+		match entry {
+			Some(ExternalFundingState::Ready {
+				temporary_channel_id, counterparty_node_id, ..
+			}) => {
+				let funding = lightning::chain::transaction::OutPoint {
+					txid: funding_txid,
+					index: funding_vout as u16,
+				};
+				self.channel_manager
+					.unsafe_manual_funding_transaction_generated(
+						temporary_channel_id,
+						counterparty_node_id,
+						funding,
+					)
+					.map_err(|e| {
+						log_error!(self.logger, "Manual funding failed: {:?}", e);
+						Error::ChannelCreationFailed
+					})?;
+				self.external_funding.lock().unwrap().remove(&user_channel_id.0);
+				Ok(())
+			},
+			_ => Err(Error::ChannelCreationFailed),
+		}
+	}
+
