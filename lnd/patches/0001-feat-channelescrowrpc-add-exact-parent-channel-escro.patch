+func TestProductionMuSigManagerFinalizesEscrowSpend(t *testing.T) {
+	t.Parallel()
+
+	localKey, _ := btcec.PrivKeyFromBytes(bytes.Repeat([]byte{1}, 32))
+	remoteKey, _ := btcec.PrivKeyFromBytes(bytes.Repeat([]byte{2}, 32))
+	channel, fundingScript := testEscrowChannel(t)
+	tx := wire.NewMsgTx(2)
+	tx.AddTxIn(&wire.TxIn{PreviousOutPoint: channel.FundingOutpoint})
+	tx.AddTxIn(&wire.TxIn{PreviousOutPoint: wire.OutPoint{Index: 2}})
+	tx.AddTxOut(&wire.TxOut{
+		Value:    900,
+		PkScript: []byte{txscript.OP_TRUE},
+	})
+	record := &channeldb.EscrowRecord{
+		ParentTx: serializeTestTx(t, tx),
+		PrevOuts: []channeldb.EscrowPrevOut{
+			{Value: 1_000, PkScript: fundingScript},
+			{
+				Value: 1_000,
+				PkScript: append(
+					[]byte{txscript.OP_0, 20},
+					bytes.Repeat([]byte{8}, 20)...,
+				),
+			},
+		},
+	}
+	hash, err := escrowSighash(record)
+	require.NoError(t, err)
+
+	manager := input.NewMusigSessionManager(
+		func(*keychain.KeyDescriptor) (*btcec.PrivateKey, error) {
+			return localKey, nil
+		},
+	)
+	keys := []*btcec.PublicKey{localKey.PubKey(), remoteKey.PubKey()}
+	tweaks := escrowTweaks(channel)
+	session, err := manager.MuSig2CreateSession(
+		input.MuSig2Version100RC2, keychain.KeyLocator{}, keys,
+		&tweaks, nil, nil,
+	)
+	require.NoError(t, err)
+	remoteNonces, err := musig2.GenNonces(
+		musig2.WithPublicKey(remoteKey.PubKey()),
+	)
+	require.NoError(t, err)
+	allNonces, err := manager.MuSig2RegisterNonces(
+		session.SessionID,
+		[][musig2.PubNonceSize]byte{remoteNonces.PubNonce},
+	)
+	require.NoError(t, err)
+	require.True(t, allNonces)
+	localPartial, err := manager.MuSig2Sign(session.SessionID, hash, false)
+	require.NoError(t, err)
+	require.NotNil(t, localPartial)
+	encodedLocalPartial, err := input.SerializePartialSignature(localPartial)
+	require.NoError(t, err)
+	record.Stage = channeldb.EscrowParentSigned
+	record.LocalPubNonce = session.PublicNonce[:]
+	record.RemotePubNonce = remoteNonces.PubNonce[:]
+	record.LocalPartialSig = encodedLocalPartial[:]
+
+	combinedNonce, err := musig2.AggregateNonces(
+		[][musig2.PubNonceSize]byte{
+			session.PublicNonce, remoteNonces.PubNonce,
+		},
+	)
+	require.NoError(t, err)
+	remotePartial, err := musig2.Sign(
+		remoteNonces.SecNonce, remoteKey, combinedNonce, keys, hash,
+		musig2.WithSortedKeys(), musig2.WithBip86SignTweak(),
+	)
+	require.NoError(t, err)
+	attempt := &signAttempt{
+		localNonce:     session.PublicNonce,
+		remoteNonce:    remoteNonces.PubNonce,
+		hasRemoteNonce: true,
+	}
+	require.NoError(t, verifyRemotePartial(
+		channel, record, attempt, remotePartial,
+	))
+
+	finalSignature, complete, err := manager.MuSig2CombineSig(
+		session.SessionID, []*musig2.PartialSignature{remotePartial},
+	)
+	require.NoError(t, err)
+	require.True(t, complete)
+	require.NotNil(t, finalSignature)
+	tx.TxIn[0].Witness = wire.TxWitness{finalSignature.Serialize()}
+	require.NoError(t, verifyEscrowInput(tx, record.PrevOuts, 0))
+	require.Error(t, verifyEscrowParent(tx, record.PrevOuts))
+
+	recoveredSignature, err := combinePersistedEscrowPartials(
+		channel, record, remotePartial,
+	)
+	require.NoError(t, err)
+	require.Equal(t, finalSignature.Serialize(), recoveredSignature.Serialize())
+}
