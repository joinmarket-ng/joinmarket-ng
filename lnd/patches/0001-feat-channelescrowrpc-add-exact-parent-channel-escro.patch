+func TestPeerRejectsNormalCloseForEscrowLockedChannel(t *testing.T) {
+	t.Parallel()
+
+	harness, err := createTestPeerWithChannel(t, noUpdate)
+	require.NoError(t, err)
+	peer := harness.peer
+	chanPoint := harness.channel.ChannelPoint()
+	chanID := lnwire.NewChanIDFromOutPoint(chanPoint)
+	channel, ok := peer.activeChannels.Load(chanID)
+	require.True(t, ok)
+	require.NotNil(t, channel)
+
+	record := &channeldb.EscrowRecord{
+		Stage: channeldb.EscrowLocked,
+	}
+	record.SessionID[0] = 1
+	require.NoError(t, channel.State().LockEscrow(record))
+	locked, err := peer.isChannelEscrowLocked(channel)
+	require.NoError(t, err)
+	require.True(t, locked)
+	shutdown, err := peer.restartCoopClose(channel)
+	require.NoError(t, err)
+	require.Nil(t, shutdown)
+
+	errChan := make(chan error, 1)
+	peer.localCloseChanReqs <- &htlcswitch.ChanClose{
+		CloseType: contractcourt.CloseRegular,
+		ChanPoint: &chanPoint,
+		Updates:   make(chan interface{}, 1),
+		Err:       errChan,
+	}
+	select {
+	case err := <-errChan:
+		require.ErrorIs(t, err, ErrChannelEscrowLocked)
+	case <-time.After(timeout):
+		t.Fatal("local close request was not rejected")
+	}
+
+	peer.chanCloseMsgs <- &closeMsg{
+		cid: chanID,
+		msg: lnwire.NewShutdown(
+			chanID, genScript(t, p2wshAddress),
+		),
+	}
+	select {
+	case outgoing := <-peer.outgoingQueue:
+		errMsg, ok := outgoing.msg.(*lnwire.Error)
+		require.True(t, ok)
+		require.Contains(t, string(errMsg.Data), ErrChannelEscrowLocked.Error())
+	case <-time.After(timeout):
+		t.Fatal("remote close request was not rejected")
+	}
+}
