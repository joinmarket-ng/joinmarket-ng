+func TestEscrowSighashUsesActualInputIndex(t *testing.T) {
+	t.Parallel()
+
+	channel, fundingScript := testEscrowChannel(t)
+	tx, rpcPrevOuts := testParent(t, channel, fundingScript)
+	record := &channeldb.EscrowRecord{
+		ParentTx:          serializeTestTx(t, tx),
+		ChannelInputIndex: 1,
+		PrevOuts: []channeldb.EscrowPrevOut{
+			{Value: rpcPrevOuts[0].ValueSat, PkScript: rpcPrevOuts[0].PkScript},
+			{Value: rpcPrevOuts[1].ValueSat, PkScript: rpcPrevOuts[1].PkScript},
+		},
+	}
+	actual, err := escrowSighash(record)
+	require.NoError(t, err)
+
+	fetcher := txscript.NewMultiPrevOutFetcher(nil)
+	for i, prevOut := range record.PrevOuts {
+		fetcher.AddPrevOut(tx.TxIn[i].PreviousOutPoint, &wire.TxOut{
+			Value: prevOut.Value, PkScript: prevOut.PkScript,
+		})
+	}
+	hashes := txscript.NewTxSigHashes(tx, fetcher)
+	expected, err := txscript.CalcTaprootSignatureHash(
+		hashes, txscript.SigHashDefault, tx, 1, fetcher,
+	)
+	require.NoError(t, err)
+	require.Equal(t, expected, actual[:])
+	indexZero, err := txscript.CalcTaprootSignatureHash(
+		hashes, txscript.SigHashDefault, tx, 0, fetcher,
+	)
+	require.NoError(t, err)
+	require.NotEqual(t, indexZero, actual[:])
+}
