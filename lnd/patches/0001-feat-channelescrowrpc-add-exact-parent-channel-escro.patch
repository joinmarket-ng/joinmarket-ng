+func TestVerifyRemotePartial(t *testing.T) {
+	t.Parallel()
+
+	localKey, _ := btcec.PrivKeyFromBytes(bytes.Repeat([]byte{1}, 32))
+	remoteKey, _ := btcec.PrivKeyFromBytes(bytes.Repeat([]byte{2}, 32))
+	channel, fundingScript := testEscrowChannel(t)
+	tx, rpcPrevOuts := testParent(t, channel, fundingScript)
+	record := &channeldb.EscrowRecord{
+		ParentTx:          serializeTestTx(t, tx),
+		ChannelInputIndex: 1,
+		PrevOuts: []channeldb.EscrowPrevOut{
+			{
+				Value:    rpcPrevOuts[0].ValueSat,
+				PkScript: rpcPrevOuts[0].PkScript,
+			},
+			{
+				Value:    rpcPrevOuts[1].ValueSat,
+				PkScript: rpcPrevOuts[1].PkScript,
+			},
+		},
+	}
+
+	makePartial := func(t *testing.T, mutateHash bool) (*signAttempt,
+		*musig2.PartialSignature) {
+
+		t.Helper()
+		localNonces, err := musig2.GenNonces(
+			musig2.WithPublicKey(localKey.PubKey()),
+		)
+		require.NoError(t, err)
+		remoteNonces, err := musig2.GenNonces(
+			musig2.WithPublicKey(remoteKey.PubKey()),
+		)
+		require.NoError(t, err)
+		combinedNonce, err := musig2.AggregateNonces(
+			[][musig2.PubNonceSize]byte{
+				localNonces.PubNonce, remoteNonces.PubNonce,
+			},
+		)
+		require.NoError(t, err)
+		hash, err := escrowSighash(record)
+		require.NoError(t, err)
+		if mutateHash {
+			hash[0] ^= 1
+		}
+		partial, err := musig2.Sign(
+			remoteNonces.SecNonce, remoteKey, combinedNonce,
+			[]*btcec.PublicKey{localKey.PubKey(), remoteKey.PubKey()},
+			hash, musig2.WithSortedKeys(),
+			musig2.WithBip86SignTweak(),
+		)
+		require.NoError(t, err)
+
+		return &signAttempt{
+			localNonce:     localNonces.PubNonce,
+			remoteNonce:    remoteNonces.PubNonce,
+			hasRemoteNonce: true,
+		}, partial
+	}
+
+	validAttempt, validPartial := makePartial(t, false)
+	require.NoError(t, verifyRemotePartial(
+		channel, record, validAttempt, validPartial,
+	))
+
+	invalidAttempt, invalidPartial := makePartial(t, true)
+	require.ErrorContains(t, verifyRemotePartial(
+		channel, record, invalidAttempt, invalidPartial,
+	), "invalid remote escrow partial signature")
+}
