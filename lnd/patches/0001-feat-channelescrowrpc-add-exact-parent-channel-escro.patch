+func testEscrowChannel(t *testing.T) (*channeldb.OpenChannel, []byte) {
+	t.Helper()
+
+	localKey, _ := btcec.PrivKeyFromBytes(bytes.Repeat([]byte{1}, 32))
+	remoteKey, _ := btcec.PrivKeyFromBytes(bytes.Repeat([]byte{2}, 32))
+	channel := &channeldb.OpenChannel{
+		ChanType:        channeldb.SimpleTaprootFeatureBit,
+		FundingOutpoint: wire.OutPoint{Hash: chainhash.Hash{3}, Index: 2},
+		Capacity:        btcutil.Amount(1000),
+		IdentityPub:     remoteKey.PubKey(),
+		LocalChanCfg: channeldb.ChannelConfig{
+			MultiSigKey: keychain.KeyDescriptor{PubKey: localKey.PubKey()},
+		},
+		RemoteChanCfg: channeldb.ChannelConfig{
+			MultiSigKey: keychain.KeyDescriptor{PubKey: remoteKey.PubKey()},
+		},
+		LocalCommitment: channeldb.ChannelCommitment{
+			LocalBalance:  600_000,
+			RemoteBalance: 400_000,
+		},
+	}
+	snapshot, err := escrowSnapshot(channel)
+	require.NoError(t, err)
+	return channel, snapshot.FundingScript
+}
+
+func testParent(t *testing.T, channel *channeldb.OpenChannel,
+	fundingScript []byte) (*wire.MsgTx, []*PrevOut) {
+	t.Helper()
+
+	tx := wire.NewMsgTx(2)
+	tx.AddTxIn(&wire.TxIn{
+		PreviousOutPoint: wire.OutPoint{Hash: chainhash.Hash{4}, Index: 1},
+	})
+	tx.AddTxIn(&wire.TxIn{PreviousOutPoint: channel.FundingOutpoint})
+	tx.AddTxOut(&wire.TxOut{Value: 1_500, PkScript: []byte{txscript.OP_TRUE}})
+
+	return tx, []*PrevOut{
+		{ValueSat: 1_000, PkScript: append([]byte{txscript.OP_0, 20}, bytes.Repeat([]byte{5}, 20)...)},
+		{ValueSat: 1_000, PkScript: fundingScript},
+	}
+}
+
+func serializeTestTx(t *testing.T, tx *wire.MsgTx) []byte {
+	t.Helper()
+	var raw bytes.Buffer
+	require.NoError(t, tx.Serialize(&raw))
+	return raw.Bytes()
+}
+
+func TestValidateParent(t *testing.T) {
+	t.Parallel()
+
+	channel, fundingScript := testEscrowChannel(t)
+	tx, prevOuts := testParent(t, channel, fundingScript)
+	raw := serializeTestTx(t, tx)
+
+	validated, actualPrevOuts, err := validateParent(channel, raw, prevOuts, 1)
+	require.NoError(t, err)
+	require.Equal(t, tx.TxHash(), validated.TxHash())
+	require.Equal(t, int64(1_000), actualPrevOuts[1].Value)
+
+	tests := []struct {
+		name   string
+		mutate func(*wire.MsgTx, []*PrevOut) uint32
+	}{
+		{
+			name: "missing funding input",
+			mutate: func(tx *wire.MsgTx, _ []*PrevOut) uint32 {
+				tx.TxIn[1].PreviousOutPoint.Hash[0]++
+				return 1
+			},
+		},
+		{
+			name: "duplicate input",
+			mutate: func(tx *wire.MsgTx, _ []*PrevOut) uint32 {
+				tx.TxIn[0].PreviousOutPoint = tx.TxIn[1].PreviousOutPoint
+				return 1
+			},
+		},
+		{
+			name: "channel witness",
+			mutate: func(tx *wire.MsgTx, _ []*PrevOut) uint32 {
+				tx.TxIn[1].Witness = wire.TxWitness{[]byte{1}}
+				return 1
+			},
+		},
+		{
+			name: "legacy prevout",
+			mutate: func(_ *wire.MsgTx, prevOuts []*PrevOut) uint32 {
+				prevOuts[0].PkScript = []byte{txscript.OP_TRUE}
+				return 1
+			},
+		},
+		{
+			name: "output over input",
+			mutate: func(tx *wire.MsgTx, _ []*PrevOut) uint32 {
+				tx.TxOut[0].Value = 2_001
+				return 1
+			},
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			copyTx := tx.Copy()
+			copyPrevOuts := []*PrevOut{
+				{ValueSat: prevOuts[0].ValueSat, PkScript: bytes.Clone(prevOuts[0].PkScript)},
+				{ValueSat: prevOuts[1].ValueSat, PkScript: bytes.Clone(prevOuts[1].PkScript)},
+			}
+			index := test.mutate(copyTx, copyPrevOuts)
+			_, _, err := validateParent(channel, serializeTestTx(t, copyTx), copyPrevOuts, index)
+			require.Error(t, err)
+		})
+	}
+
+	_, _, err = validateParent(channel, raw, prevOuts[:1], 1)
+	require.Error(t, err)
+}
