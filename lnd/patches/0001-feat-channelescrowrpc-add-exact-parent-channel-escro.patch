+package channeldb
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+
+	"github.com/btcsuite/btcd/chaincfg/chainhash"
+	"github.com/btcsuite/btcd/wire"
+	"github.com/lightningnetwork/lnd/kvdb"
+)
+
+var (
+	// ErrNoEscrowRecord is returned when a channel has no escrow state.
+	ErrNoEscrowRecord = errors.New("channel has no escrow record")
+
+	// ErrEscrowSessionMismatch is returned for a request that does not own the
+	// existing escrow lock.
+	ErrEscrowSessionMismatch = errors.New("escrow session does not match lock")
+
+	// ErrEscrowMutation is returned when an immutable escrow parent is changed.
+	ErrEscrowMutation = errors.New("escrow parent mutation rejected")
+
+	// ErrEscrowAlreadySigned is returned when an operation would unlock or
+	// mutate an escrow after releasing a local partial signature.
+	ErrEscrowAlreadySigned = errors.New("escrow has released a local signature")
+)
+
+var escrowRecordKey = []byte("channel-escrow-v1")
+var escrowCancellationKey = []byte("channel-escrow-canceled-v1")
+
+const (
+	escrowEncodingVersion byte = 1
+	maxEscrowBlobSize          = 4 * 1024 * 1024
+	maxEscrowRecordSize        = 8 * 1024 * 1024
+)
+
+// EscrowStage describes the durable part of the escrow protocol.
+type EscrowStage uint8
+
+const (
+	EscrowLocked EscrowStage = iota
+	EscrowParentPrepared
+	EscrowParentSigned
+	EscrowFinalized
+)
+
+// EscrowPrevOut is a parent transaction prevout. Prevouts are kept in input
+// order because BIP341 commits to the complete set.
+type EscrowPrevOut struct {
+	Value    int64
+	PkScript []byte
+}
+
+// EscrowSnapshot is the stable FreezeChannel response persisted with the lock.
+// Amounts are satoshis.
+type EscrowSnapshot struct {
+	Capacity      int64
+	LocalClaim    int64
+	RemoteClaim   int64
+	PeerPubKey    [33]byte
+	FundingScript []byte
+	LocalFunding  [33]byte
+	RemoteFunding [33]byte
+}
+
+// EscrowRecord is the complete durable authorization for a parent spend. It
+// deliberately contains no private nonce or MuSig2 session state.
+type EscrowRecord struct {
+	SessionID         [32]byte
+	Stage             EscrowStage
+	Snapshot          EscrowSnapshot
+	ParentTx          []byte
+	PrevOuts          []EscrowPrevOut
+	ChannelInputIndex uint32
+	ParentTxID        chainhash.Hash
+	LocalPubNonce     []byte
+	RemotePubNonce    []byte
+	LocalPartialSig   []byte
+	FinalTx           []byte
+}
+
+// EscrowRecord returns a copy of the channel's durable escrow authorization.
+func (c *OpenChannel) EscrowRecord() (*EscrowRecord, error) {
+	var record *EscrowRecord
+	err := kvdb.View(c.Db.backend, func(tx kvdb.RTx) error {
+		bucket, err := fetchChanBucket(
+			tx, c.IdentityPub, &c.FundingOutpoint, c.ChainHash,
+		)
+		if err != nil {
+			return err
+		}
+		data := bucket.Get(escrowRecordKey)
+		if data == nil {
+			return ErrNoEscrowRecord
+		}
+		record, err = decodeEscrowRecord(data)
+		return err
+	}, func() { record = nil })
+	if err != nil {
+		return nil, err
+	}
+	return record, nil
+}
+
+// LockEscrow atomically writes a new escrow authorization and locks a channel.
+// A retry with the same session and snapshot is idempotent.
+func (c *OpenChannel) LockEscrow(record *EscrowRecord) error {
+	if record == nil || record.Stage != EscrowLocked {
+		return fmt.Errorf("invalid initial escrow record")
+	}
+	return c.updateEscrow(func(channel *OpenChannel, bucket kvdb.RwBucket) error {
+		if bytes.Equal(bucket.Get(escrowCancellationKey), record.SessionID[:]) {
+			return ErrEscrowSessionMismatch
+		}
+		existing := bucket.Get(escrowRecordKey)
+		if existing != nil {
+			current, err := decodeEscrowRecord(existing)
+			if err != nil {
+				return err
+			}
+			if current.SessionID != record.SessionID ||
+				!equalEscrowSnapshot(current.Snapshot, record.Snapshot) {
+				return ErrEscrowSessionMismatch
+			}
+			return nil
+		}
+		if channel.chanStatus != ChanStatusDefault {
+			return fmt.Errorf("channel is not in default state: %v", channel.chanStatus)
+		}
+		encoded, err := encodeEscrowRecord(record)
+		if err != nil {
+			return err
+		}
+		channel.chanStatus |= ChanStatusEscrowLocked
+		if err := putOpenChannel(bucket, channel); err != nil {
+			return err
+		}
+		return bucket.Put(escrowRecordKey, encoded)
+	})
+}
+
+// PrepareEscrowParent atomically persists the only parent this channel may
+// sign. A byte-for-byte retry is idempotent, all other changes fail closed.
+func (c *OpenChannel) PrepareEscrowParent(sessionID [32]byte, parent []byte,
+	prevOuts []EscrowPrevOut, channelInputIndex uint32, txid chainhash.Hash) error {
+
+	return c.updateEscrow(func(channel *OpenChannel, bucket kvdb.RwBucket) error {
+		record, err := escrowRecordForSession(bucket, sessionID)
+		if err != nil {
+			return err
+		}
+		if record.Stage >= EscrowParentPrepared {
+			if bytes.Equal(record.ParentTx, parent) &&
+				equalEscrowPrevOuts(record.PrevOuts, prevOuts) &&
+				record.ChannelInputIndex == channelInputIndex && record.ParentTxID == txid {
+				return nil
+			}
+			return ErrEscrowMutation
+		}
+		record.Stage = EscrowParentPrepared
+		record.ParentTx = bytes.Clone(parent)
+		record.PrevOuts = cloneEscrowPrevOuts(prevOuts)
+		record.ChannelInputIndex = channelInputIndex
+		record.ParentTxID = txid
+		return putEscrowRecord(bucket, record)
+	})
+}
+
+// StoreEscrowPartial atomically records the public signing evidence before a
+// local partial signature is returned to a caller.
+func (c *OpenChannel) StoreEscrowPartial(sessionID [32]byte, localNonce,
+	remoteNonce, localPartial []byte) error {
+	if len(localNonce) != 66 || len(remoteNonce) != 66 ||
+		len(localPartial) != 32 {
+
+		return errors.New("invalid escrow signing evidence length")
+	}
+
+	return c.updateEscrow(func(channel *OpenChannel, bucket kvdb.RwBucket) error {
+		record, err := escrowRecordForSession(bucket, sessionID)
+		if err != nil {
+			return err
+		}
+		if record.Stage == EscrowFinalized {
+			return nil
+		}
+		if record.Stage == EscrowParentSigned {
+			// A fresh in-memory MuSig2 attempt after a restart must use new
+			// nonces. Keep the latest complete public attempt as durable audit
+			// evidence while retaining the irreversible signed stage.
+			record.LocalPubNonce = bytes.Clone(localNonce)
+			record.RemotePubNonce = bytes.Clone(remoteNonce)
+			record.LocalPartialSig = bytes.Clone(localPartial)
+			return putEscrowRecord(bucket, record)
+		}
+		if record.Stage != EscrowParentPrepared {
+			return fmt.Errorf("parent has not been prepared")
+		}
+		record.Stage = EscrowParentSigned
+		record.LocalPubNonce = bytes.Clone(localNonce)
+		record.RemotePubNonce = bytes.Clone(remoteNonce)
+		record.LocalPartialSig = bytes.Clone(localPartial)
+		return putEscrowRecord(bucket, record)
+	})
+}
+
+// CancelEscrow removes the authorization and only its lock bit. Cancellation
+// is prohibited after a local partial signature has been persisted.
+func (c *OpenChannel) CancelEscrow(sessionID [32]byte) error {
+	return c.updateEscrow(func(channel *OpenChannel, bucket kvdb.RwBucket) error {
+		record, err := escrowRecordForSession(bucket, sessionID)
+		if errors.Is(err, ErrNoEscrowRecord) &&
+			bytes.Equal(bucket.Get(escrowCancellationKey), sessionID[:]) {
+
+			return nil
+		}
+
+		if err != nil {
+			return err
+		}
+		if record.Stage >= EscrowParentSigned || len(record.LocalPartialSig) != 0 {
+			return ErrEscrowAlreadySigned
+		}
+		channel.chanStatus &^= ChanStatusEscrowLocked
+		if err := putOpenChannel(bucket, channel); err != nil {
+			return err
+		}
+		if err := bucket.Put(escrowCancellationKey, sessionID[:]); err != nil {
+			return err
+		}
+		return bucket.Delete(escrowRecordKey)
+	})
+}
+
+// FinalizeEscrowInput atomically records the parent with its finalized channel
+// input witness, preserving the escrow lock for audit and exact-spend
+// classification. Other CoinJoin input witnesses may still be absent, so this
+// does not mark the transaction broadcast or schedule it for publication.
+func (c *OpenChannel) FinalizeEscrowInput(sessionID [32]byte, closeTx *wire.MsgTx) error {
+
+	if closeTx == nil {
+		return errors.New("nil escrow cooperative transaction")
+	}
+	var txBuf bytes.Buffer
+	if err := closeTx.Serialize(&txBuf); err != nil {
+		return err
+	}
+	return c.updateEscrow(func(channel *OpenChannel, bucket kvdb.RwBucket) error {
+		record, err := escrowRecordForSession(bucket, sessionID)
+		if err != nil {
+			return err
+		}
+		if record.Stage == EscrowFinalized {
+			if bytes.Equal(record.FinalTx, txBuf.Bytes()) {
+				return nil
+			}
+			return ErrEscrowMutation
+		}
+		if record.Stage != EscrowParentSigned {
+			return fmt.Errorf("parent has not been signed")
+		}
+		if closeTx.TxHash() != record.ParentTxID {
+			return ErrEscrowMutation
+		}
+		record.Stage = EscrowFinalized
+		record.FinalTx = txBuf.Bytes()
+		if err := putEscrowRecord(bucket, record); err != nil {
+			return err
+		}
+		channel.chanStatus |= ChanStatusEscrowLocked
+		return putOpenChannel(bucket, channel)
+	})
+}
+
+func (c *OpenChannel) updateEscrow(f func(*OpenChannel, kvdb.RwBucket) error) error {
+	c.Lock()
+	defer c.Unlock()
+	var status ChannelStatus
+	err := kvdb.Update(c.Db.backend, func(tx kvdb.RwTx) error {
+		bucket, err := fetchChanBucketRw(tx, c.IdentityPub, &c.FundingOutpoint, c.ChainHash)
+		if err != nil {
+			return err
+		}
+		channel, err := fetchOpenChannel(bucket, &c.FundingOutpoint)
+		if err != nil {
+			return err
+		}
+		if err := f(channel, bucket); err != nil {
+			return err
+		}
+		status = channel.chanStatus
+		return nil
+	}, func() {})
+	if err == nil {
+		c.chanStatus = status
+	}
+	return err
+}
+
+func escrowRecordForSession(bucket kvdb.RBucket, sessionID [32]byte) (*EscrowRecord, error) {
+	data := bucket.Get(escrowRecordKey)
+	if data == nil {
+		return nil, ErrNoEscrowRecord
+	}
+	record, err := decodeEscrowRecord(data)
+	if err != nil {
+		return nil, err
+	}
+	if record.SessionID != sessionID {
+		return nil, ErrEscrowSessionMismatch
+	}
+	return record, nil
+}
+
+func putEscrowRecord(bucket kvdb.RwBucket, record *EscrowRecord) error {
+	encoded, err := encodeEscrowRecord(record)
+	if err != nil {
+		return err
+	}
+	return bucket.Put(escrowRecordKey, encoded)
+}
+
+func encodeEscrowRecord(record *EscrowRecord) ([]byte, error) {
+	if record == nil || record.Stage > EscrowFinalized {
+		return nil, errors.New("invalid escrow record")
+	}
+	var buf bytes.Buffer
+	buf.WriteByte(escrowEncodingVersion)
+	buf.Write(record.SessionID[:])
+	buf.WriteByte(byte(record.Stage))
+	if err := binary.Write(&buf, binary.BigEndian, record.Snapshot.Capacity); err != nil {
+		return nil, err
+	}
+	if err := binary.Write(&buf, binary.BigEndian, record.Snapshot.LocalClaim); err != nil {
+		return nil, err
+	}
+	if err := binary.Write(&buf, binary.BigEndian, record.Snapshot.RemoteClaim); err != nil {
+		return nil, err
+	}
+	buf.Write(record.Snapshot.PeerPubKey[:])
+	if err := writeEscrowBytes(&buf, record.Snapshot.FundingScript); err != nil {
+		return nil, err
+	}
+	buf.Write(record.Snapshot.LocalFunding[:])
+	buf.Write(record.Snapshot.RemoteFunding[:])
+	if err := writeEscrowBytes(&buf, record.ParentTx); err != nil {
+		return nil, err
+	}
+	if len(record.PrevOuts) > 1<<16 {
+		return nil, errors.New("too many escrow prevouts")
+	}
+	if err := binary.Write(&buf, binary.BigEndian, uint32(len(record.PrevOuts))); err != nil {
+		return nil, err
+	}
+	for _, prevOut := range record.PrevOuts {
+		if err := binary.Write(&buf, binary.BigEndian, prevOut.Value); err != nil {
+			return nil, err
+		}
+		if err := writeEscrowBytes(&buf, prevOut.PkScript); err != nil {
+			return nil, err
+		}
+	}
+	if err := binary.Write(&buf, binary.BigEndian, record.ChannelInputIndex); err != nil {
+		return nil, err
+	}
+	buf.Write(record.ParentTxID[:])
+	for _, field := range [][]byte{record.LocalPubNonce, record.RemotePubNonce, record.LocalPartialSig, record.FinalTx} {
+		if err := writeEscrowBytes(&buf, field); err != nil {
+			return nil, err
+		}
+	}
+	if buf.Len() > maxEscrowRecordSize {
+		return nil, errors.New("escrow record too large")
+	}
+	return buf.Bytes(), nil
+}
+
+func decodeEscrowRecord(data []byte) (*EscrowRecord, error) {
+	if len(data) > maxEscrowRecordSize {
+		return nil, errors.New("escrow record too large")
+	}
+	r := bytes.NewReader(data)
+	version, err := r.ReadByte()
+	if err != nil || version != escrowEncodingVersion {
+		return nil, errors.New("unknown escrow record version")
+	}
+	record := &EscrowRecord{}
+	if _, err := io.ReadFull(r, record.SessionID[:]); err != nil {
+		return nil, err
+	}
+	stage, err := r.ReadByte()
+	if err != nil || EscrowStage(stage) > EscrowFinalized {
+		return nil, errors.New("invalid escrow stage")
+	}
+	record.Stage = EscrowStage(stage)
+	for _, value := range []*int64{&record.Snapshot.Capacity, &record.Snapshot.LocalClaim, &record.Snapshot.RemoteClaim} {
+		if err := binary.Read(r, binary.BigEndian, value); err != nil {
+			return nil, err
+		}
+	}
+	if _, err := io.ReadFull(r, record.Snapshot.PeerPubKey[:]); err != nil {
+		return nil, err
+	}
+	if record.Snapshot.FundingScript, err = readEscrowBytes(r); err != nil {
+		return nil, err
+	}
+	if _, err := io.ReadFull(r, record.Snapshot.LocalFunding[:]); err != nil {
+		return nil, err
+	}
+	if _, err := io.ReadFull(r, record.Snapshot.RemoteFunding[:]); err != nil {
+		return nil, err
+	}
+	if record.ParentTx, err = readEscrowBytes(r); err != nil {
+		return nil, err
+	}
+	var count uint32
+	if err := binary.Read(r, binary.BigEndian, &count); err != nil || count > 1<<16 {
+		return nil, errors.New("invalid escrow prevout count")
+	}
+	record.PrevOuts = make([]EscrowPrevOut, count)
+	for i := range record.PrevOuts {
+		if err := binary.Read(r, binary.BigEndian, &record.PrevOuts[i].Value); err != nil {
+			return nil, err
+		}
+		if record.PrevOuts[i].PkScript, err = readEscrowBytes(r); err != nil {
+			return nil, err
+		}
+	}
+	if err := binary.Read(r, binary.BigEndian, &record.ChannelInputIndex); err != nil {
+		return nil, err
+	}
+	if _, err := io.ReadFull(r, record.ParentTxID[:]); err != nil {
+		return nil, err
+	}
+	fields := []*[]byte{&record.LocalPubNonce, &record.RemotePubNonce, &record.LocalPartialSig, &record.FinalTx}
+	for _, field := range fields {
+		if *field, err = readEscrowBytes(r); err != nil {
+			return nil, err
+		}
+	}
+	if r.Len() != 0 {
+		return nil, errors.New("trailing escrow record data")
+	}
+	return record, nil
+}
+
+func writeEscrowBytes(w io.Writer, value []byte) error {
+	if len(value) > maxEscrowBlobSize {
+		return errors.New("escrow field too large")
+	}
+	if err := binary.Write(w, binary.BigEndian, uint32(len(value))); err != nil {
+		return err
+	}
+	_, err := w.Write(value)
+	return err
+}
+
+func readEscrowBytes(r io.Reader) ([]byte, error) {
+	var length uint32
+	if err := binary.Read(r, binary.BigEndian, &length); err != nil || length > maxEscrowBlobSize {
+		return nil, errors.New("invalid escrow field length")
+	}
+	value := make([]byte, length)
+	_, err := io.ReadFull(r, value)
+	return value, err
+}
+
+func equalEscrowSnapshot(a, b EscrowSnapshot) bool {
+	return a.Capacity == b.Capacity && a.LocalClaim == b.LocalClaim && a.RemoteClaim == b.RemoteClaim &&
+		a.PeerPubKey == b.PeerPubKey && bytes.Equal(a.FundingScript, b.FundingScript) &&
+		a.LocalFunding == b.LocalFunding && a.RemoteFunding == b.RemoteFunding
+}
+
+func equalEscrowPrevOuts(a, b []EscrowPrevOut) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i].Value != b[i].Value || !bytes.Equal(a[i].PkScript, b[i].PkScript) {
+			return false
+		}
+	}
+	return true
+}
+
+func cloneEscrowPrevOuts(prevOuts []EscrowPrevOut) []EscrowPrevOut {
+	cloned := make([]EscrowPrevOut, len(prevOuts))
+	for i := range prevOuts {
+		cloned[i] = EscrowPrevOut{Value: prevOuts[i].Value, PkScript: bytes.Clone(prevOuts[i].PkScript)}
+	}
+	return cloned
+}
