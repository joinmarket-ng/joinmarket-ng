+
+func testEscrowRecord() *EscrowRecord {
+	var sessionID [32]byte
+	copy(sessionID[:], bytes.Repeat([]byte{1}, len(sessionID)))
+
+	parent := wire.NewMsgTx(2)
+	parent.AddTxIn(&wire.TxIn{
+		PreviousOutPoint: wire.OutPoint{Hash: chainhash.Hash{2}, Index: 3},
+	})
+	parent.AddTxOut(&wire.TxOut{Value: 100, PkScript: []byte{0x51, 0x20, 1}})
+	var parentBytes bytes.Buffer
+	_ = parent.Serialize(&parentBytes)
+
+	return &EscrowRecord{
+		SessionID: sessionID,
+		Stage:     EscrowParentPrepared,
+		Snapshot: EscrowSnapshot{
