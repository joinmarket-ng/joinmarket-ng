+func testLockedEscrowRecord() *EscrowRecord {
+	record := testEscrowRecord()
+	record.Stage = EscrowLocked
+	record.ParentTx = nil
+	record.PrevOuts = nil
+	record.ParentTxID = chainhash.Hash{}
