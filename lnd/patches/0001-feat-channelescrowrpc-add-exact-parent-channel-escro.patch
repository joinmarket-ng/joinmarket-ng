+func (p *Brontide) isChannelEscrowLocked(
+	channel *lnwallet.LightningChannel) (bool, error) {
+
+	dbChannel, err := p.cfg.ChannelDB.FetchChannel(channel.ChannelPoint())
+	if err != nil {
+		return false, err
+	}
+	if dbChannel.HasChanStatus(channeldb.ChanStatusEscrowLocked) {
+		return true, nil
+	}
+	if _, err := dbChannel.EscrowRecord(); err == nil {
+		return true, nil
+	} else if !errors.Is(err, channeldb.ErrNoEscrowRecord) {
+		return false, err
+	}
+
+	return false, nil
+}
