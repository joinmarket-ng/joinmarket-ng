+
+func TestEscrowRecordEncoding(t *testing.T) {
+	t.Parallel()
+
+	record := testEscrowRecord()
+	encoded, err := encodeEscrowRecord(record)
+	require.NoError(t, err)
+
+	decoded, err := decodeEscrowRecord(encoded)
+	require.NoError(t, err)
+	require.Equal(t, record, decoded)
+
+	record.ParentTx[0] ^= 1
+	record.PrevOuts[0].PkScript[0] ^= 1
+	record.Snapshot.FundingScript[0] ^= 1
+	require.NotEqual(t, record.ParentTx, decoded.ParentTx)
+	require.NotEqual(t, record.PrevOuts[0].PkScript, decoded.PrevOuts[0].PkScript)
+	require.NotEqual(t, record.Snapshot.FundingScript, decoded.Snapshot.FundingScript)
+
+	_, err = decodeEscrowRecord(append(encoded, 1))
+	require.Error(t, err)
+	_, err = decodeEscrowRecord(encoded[:len(encoded)-1])
+	require.Error(t, err)
+	corrupt := bytes.Clone(encoded)
+	corrupt[0]++
+	_, err = decodeEscrowRecord(corrupt)
+	require.Error(t, err)
+
+	oversized := testEscrowRecord()
+	oversized.ParentTx = make([]byte, maxEscrowBlobSize+1)
+	_, err = encodeEscrowRecord(oversized)
+	require.Error(t, err)
+
+	var oversizedLength [4]byte
+	binary.BigEndian.PutUint32(oversizedLength[:], maxEscrowBlobSize+1)
+	_, err = readEscrowBytes(bytes.NewReader(oversizedLength[:]))
+	require.Error(t, err)
+
+	oversizedRecord := testEscrowRecord()
+	oversizedRecord.ParentTx = make([]byte, maxEscrowBlobSize)
+	oversizedRecord.FinalTx = make([]byte, maxEscrowBlobSize)
+	_, err = encodeEscrowRecord(oversizedRecord)
+	require.Error(t, err)
+	_, err = decodeEscrowRecord(make([]byte, maxEscrowRecordSize+1))
+	require.Error(t, err)
+}
+
+func TestEscrowRecordDurableTransitions(t *testing.T) {
+	t.Parallel()
+
+	fullDB, err := MakeTestDB(t)
+	require.NoError(t, err)
+	channel := createTestChannel(t, fullDB.ChannelStateDB())
+
+	record := testLockedEscrowRecord()
+	require.NoError(t, channel.LockEscrow(record))
+	require.True(t, channel.HasChanStatus(ChanStatusEscrowLocked))
+	record.Snapshot.FundingScript[0] ^= 1
+
+	reloaded, err := fullDB.ChannelStateDB().FetchChannel(channel.FundingOutpoint)
+	require.NoError(t, err)
+	persisted, err := reloaded.EscrowRecord()
+	require.NoError(t, err)
+	require.Equal(t, record.SessionID, persisted.SessionID)
+	require.NotEqual(t, record.Snapshot, persisted.Snapshot)
+	record.Snapshot.FundingScript[0] ^= 1
+
+	require.NoError(t, reloaded.LockEscrow(record))
+	other := testLockedEscrowRecord()
+	other.SessionID[0]++
+	require.ErrorIs(t, reloaded.LockEscrow(other), ErrEscrowSessionMismatch)
+
+	prepared := testEscrowRecord()
+	require.NoError(t, reloaded.PrepareEscrowParent(
+		prepared.SessionID, prepared.ParentTx, prepared.PrevOuts,
+		prepared.ChannelInputIndex, prepared.ParentTxID,
+	))
+	require.NoError(t, reloaded.PrepareEscrowParent(
+		prepared.SessionID, prepared.ParentTx, prepared.PrevOuts,
+		prepared.ChannelInputIndex, prepared.ParentTxID,
+	))
+	mutated := bytes.Clone(prepared.ParentTx)
+	mutated[len(mutated)-1] ^= 1
+	require.ErrorIs(t, reloaded.PrepareEscrowParent(
+		prepared.SessionID, mutated, prepared.PrevOuts,
+		prepared.ChannelInputIndex, prepared.ParentTxID,
+	), ErrEscrowMutation)
+
+	localNonce := bytes.Repeat([]byte{1}, 66)
+	remoteNonce := bytes.Repeat([]byte{2}, 66)
+	partial := bytes.Repeat([]byte{3}, 32)
+	require.NoError(t, reloaded.StoreEscrowPartial(
+		prepared.SessionID, localNonce, remoteNonce, partial,
+	))
+	require.ErrorIs(t, reloaded.CancelEscrow(prepared.SessionID), ErrEscrowAlreadySigned)
+
+	freshLocalNonce := bytes.Repeat([]byte{4}, 66)
+	freshRemoteNonce := bytes.Repeat([]byte{5}, 66)
+	freshPartial := bytes.Repeat([]byte{6}, 32)
+	require.NoError(t, reloaded.StoreEscrowPartial(
+		prepared.SessionID, freshLocalNonce, freshRemoteNonce, freshPartial,
+	))
+	persisted, err = reloaded.EscrowRecord()
+	require.NoError(t, err)
+	require.Equal(t, freshLocalNonce, persisted.LocalPubNonce)
+	require.Equal(t, freshRemoteNonce, persisted.RemotePubNonce)
+	require.Equal(t, freshPartial, persisted.LocalPartialSig)
+
+	var parent wire.MsgTx
+	require.NoError(t, parent.Deserialize(bytes.NewReader(prepared.ParentTx)))
+	parent.TxIn[0].Witness = wire.TxWitness{bytes.Repeat([]byte{9}, 64)}
+	require.NoError(t, reloaded.FinalizeEscrowInput(prepared.SessionID, &parent))
+	require.False(t, reloaded.HasChanStatus(ChanStatusCoopBroadcasted))
+	_, err = reloaded.BroadcastedCooperative()
+	require.ErrorIs(t, err, ErrNoCloseTx)
+	require.NoError(t, reloaded.FinalizeEscrowInput(prepared.SessionID, &parent))
+	parent.TxOut[0].Value++
+	require.ErrorIs(
+		t, reloaded.FinalizeEscrowInput(prepared.SessionID, &parent),
+		ErrEscrowMutation,
+	)
+}
+
+func TestEscrowCancelAndStatusString(t *testing.T) {
+	t.Parallel()
+
+	fullDB, err := MakeTestDB(t)
+	require.NoError(t, err)
+	channel := createTestChannel(t, fullDB.ChannelStateDB())
+	record := testLockedEscrowRecord()
+	require.NoError(t, channel.LockEscrow(record))
+	require.Contains(t, channel.ChanStatus().String(), "ChanStatusEscrowLocked")
+	require.NoError(t, channel.CancelEscrow(record.SessionID))
+	require.False(t, channel.HasChanStatus(ChanStatusEscrowLocked))
+	_, err = channel.EscrowRecord()
+	require.True(t, errors.Is(err, ErrNoEscrowRecord))
+}
+
+func TestEscrowCancellationReceipt(t *testing.T) {
+	t.Parallel()
+
+	fullDB, err := MakeTestDB(t)
+	require.NoError(t, err)
+	channel := createTestChannel(t, fullDB.ChannelStateDB())
+	record := testLockedEscrowRecord()
+	// Absence alone is never a cancellation receipt.
+	require.ErrorIs(t, channel.CancelEscrow(record.SessionID), ErrNoEscrowRecord)
+	require.NoError(t, channel.LockEscrow(record))
+	require.NoError(t, channel.CancelEscrow(record.SessionID))
+	reloaded, err := fullDB.ChannelStateDB().FetchChannel(channel.FundingOutpoint)
+	require.NoError(t, err)
+	require.NoError(t, reloaded.CancelEscrow(record.SessionID))
+	require.ErrorIs(t, reloaded.LockEscrow(record), ErrEscrowSessionMismatch)
+
+	other := testLockedEscrowRecord()
+	other.SessionID[0] ^= 1
+	require.ErrorIs(t, reloaded.CancelEscrow(other.SessionID), ErrNoEscrowRecord)
+	require.NoError(t, reloaded.LockEscrow(other))
+	require.ErrorIs(t, reloaded.CancelEscrow(record.SessionID), ErrEscrowSessionMismatch)
+	require.True(t, reloaded.HasChanStatus(ChanStatusEscrowLocked))
+	current, err := reloaded.EscrowRecord()
+	require.NoError(t, err)
+	require.Equal(t, other.SessionID, current.SessionID)
+	require.NoError(t, reloaded.CancelEscrow(other.SessionID))
+	require.NoError(t, reloaded.CancelEscrow(other.SessionID))
+	// A receipt for a different epoch is not affirmative evidence.
+	require.ErrorIs(t, reloaded.CancelEscrow(record.SessionID), ErrNoEscrowRecord)
+}
