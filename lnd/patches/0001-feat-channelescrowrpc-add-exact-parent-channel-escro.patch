+package contractcourt
+
+import (
+	"testing"
+
+	"github.com/btcsuite/btcd/chaincfg/chainhash"
+	"github.com/btcsuite/btcd/mempool"
+	"github.com/btcsuite/btcd/wire"
+	"github.com/lightningnetwork/lnd/channeldb"
+	"github.com/stretchr/testify/require"
+)
+
+func TestEscrowCooperativeSpendClassification(t *testing.T) {
+	t.Parallel()
+
+	exactID := chainhash.Hash{1}
+	record := &channeldb.EscrowRecord{
+		Stage:      channeldb.EscrowParentSigned,
+		ParentTxID: exactID,
+	}
+	require.True(t, isEscrowCooperativeSpend(record, exactID))
+	require.False(t, isEscrowCooperativeSpend(record, chainhash.Hash{2}))
+	require.False(t, isEscrowCooperativeSpend(&channeldb.EscrowRecord{
+		Stage: channeldb.EscrowParentPrepared, ParentTxID: exactID,
+	}, exactID))
+
+	// Sequence remains a cooperative-close heuristic only for ordinary
+	// channels, never a fallback for an escrow-locked channel.
+	seq := func(sequence uint32) *wire.MsgTx {
+		return &wire.MsgTx{TxIn: []*wire.TxIn{{Sequence: sequence}}}
+	}
+	require.True(t, isCoopCloseSpend(seq(wire.MaxTxInSequenceNum)))
+	require.True(t, isCoopCloseSpend(seq(mempool.MaxRBFSequence)))
+	require.False(t, isCoopCloseSpend(seq(0)))
+}
