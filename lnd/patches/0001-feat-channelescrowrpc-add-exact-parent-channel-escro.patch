+func TestPublishFinalizedCanBeRetried(t *testing.T) {
+	t.Parallel()
+
+	channel, _ := testEscrowChannel(t)
+	tx := wire.NewMsgTx(2)
+	tx.AddTxIn(&wire.TxIn{PreviousOutPoint: channel.FundingOutpoint})
+	switchMock := &testChannelSwitch{}
+	publishCalls := 0
+	server := &Server{cfg: &Config{
+		Switch: switchMock,
+		PublishTransaction: func(*wire.MsgTx, string) error {
+			publishCalls++
+			if publishCalls == 1 {
+				return errors.New("temporary publish failure")
+			}
+			return nil
+		},
+	}}
+
+	err := server.publishFinalized(
+		channel, channel.FundingOutpoint, tx,
+	)
+	require.ErrorContains(t, err, "temporary publish failure")
+	require.NoError(t, server.publishFinalized(
+		channel, channel.FundingOutpoint, tx,
+	))
+	require.Equal(t, 2, publishCalls)
+	require.Len(t, switchMock.removed, 2)
+}
