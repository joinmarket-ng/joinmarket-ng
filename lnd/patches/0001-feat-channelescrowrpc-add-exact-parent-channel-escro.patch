+// FreezeChannel quiesces a clean SIMPLE_TAPROOT channel and atomically locks
+// it before a parent can be supplied.
+func (s *Server) FreezeChannel(ctx context.Context, req *FreezeChannelRequest) (
+	*FreezeChannelResponse, error) {
+
+	op, sessionID, err := parseChannelAndSession(req.GetChannelPoint(), req.GetSessionId())
+	if err != nil {
+		return nil, err
+	}
+	channel, err := s.cfg.ChanStateDB.FetchChannel(*op)
+	if err != nil {
+		return nil, err
+	}
+	if record, err := channel.EscrowRecord(); err == nil {
+		if record.SessionID != sessionID {
+			return nil, channeldb.ErrEscrowSessionMismatch
+		}
+		return freezeResponse(record.Snapshot, *op), nil
+	} else if !errors.Is(err, channeldb.ErrNoEscrowRecord) {
+		return nil, err
+	}
+	if channel.ChanStatus() != channeldb.ChanStatusDefault || !channel.ChanType.IsTaproot() {
+		return nil, fmt.Errorf("channel is not an unlocked SIMPLE_TAPROOT channel")
+	}
+
+	link, err := s.cfg.Switch.GetLink(lnwire.NewChanIDFromOutPoint(*op))
+	if err != nil {
+		return nil, err
+	}
+	if link.IsFlushing(htlcswitch.Incoming) ||
+		link.IsFlushing(htlcswitch.Outgoing) {
+
+		return nil, errors.New("channel already has disabled HTLC adds")
+	}
+	select {
+	case result := <-link.InitStfu():
+		if _, err := result.Unpack(); err != nil {
+			return nil, err
+		}
+	case <-ctx.Done():
+		link.ResumeQuiescence()
+		return nil, ctx.Err()
+	}
+	incomingDisabled := link.DisableAdds(htlcswitch.Incoming)
+	outgoingDisabled := link.DisableAdds(htlcswitch.Outgoing)
+	rollback := func() {
+		if incomingDisabled {
+			link.EnableAdds(htlcswitch.Incoming)
+		}
+		if outgoingDisabled {
+			link.EnableAdds(htlcswitch.Outgoing)
+		}
+		link.ResumeQuiescence()
+	}
+	if !incomingDisabled || !outgoingDisabled {
+		rollback()
+		return nil, errors.New("channel HTLC add state changed while quiescing")
+	}
+	if !link.IsChannelClean() {
+		rollback()
+		return nil, errors.New("channel is not clean after quiescence")
+	}
+
+	// Re-fetch after quiescence to avoid authorizing a stale channel snapshot.
+	channel, err = s.cfg.ChanStateDB.FetchChannel(*op)
+	if err != nil {
+		rollback()
+		return nil, err
+	}
+	if channel.ChanStatus() != channeldb.ChanStatusDefault || !channel.ChanType.IsTaproot() {
+		rollback()
+		return nil, errors.New("channel changed while being quiesced")
+	}
+	snapshot, err := escrowSnapshot(channel)
+	if err != nil {
+		rollback()
+		return nil, err
+	}
+	if err := channel.LockEscrow(&channeldb.EscrowRecord{
+		SessionID: sessionID,
+		Stage:     channeldb.EscrowLocked,
+		Snapshot:  snapshot,
+	}); err != nil {
+		rollback()
+		return nil, err
+	}
+	return freezeResponse(snapshot, *op), nil
+}
+
+// PrepareParent validates and records the sole transaction that may spend the
+// locked funding output.
+func (s *Server) PrepareParent(_ context.Context, req *PrepareParentRequest) (
+	*PrepareParentResponse, error) {
+
+	op, sessionID, err := parseChannelAndSession(req.GetChannelPoint(), req.GetSessionId())
+	if err != nil {
+		return nil, err
+	}
+	channel, err := s.cfg.ChanStateDB.FetchChannel(*op)
+	if err != nil {
+		return nil, err
+	}
+	tx, prevOuts, err := validateParent(channel, req.GetRawParentTx(), req.GetPrevOuts(), req.GetChannelInputIndex())
+	if err != nil {
+		return nil, err
+	}
+	txid := tx.TxHash()
+	if err := channel.PrepareEscrowParent(sessionID, req.GetRawParentTx(), prevOuts,
+		req.GetChannelInputIndex(), txid); err != nil {
+		return nil, err
+	}
+	return &PrepareParentResponse{Txid: txid[:]}, nil
+}
+
+func (s *Server) BeginSigning(_ context.Context, req *BeginSigningRequest) (
+	*BeginSigningResponse, error) {
+
+	op, sessionID, err := parseChannelAndSession(req.GetChannelPoint(), req.GetSessionId())
+	if err != nil {
+		return nil, err
+	}
+	key := attemptKey(*op, sessionID)
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	channel, err := s.cfg.ChanStateDB.FetchChannel(*op)
+	if err != nil {
+		return nil, err
+	}
+	record, err := channel.EscrowRecord()
+	if err != nil || record.SessionID != sessionID ||
+		record.Stage < channeldb.EscrowParentPrepared ||
+		record.Stage == channeldb.EscrowFinalized {
+
+		return nil, fmt.Errorf("prepared escrow parent required")
+	}
+	if active := s.attempts[key]; active != nil {
+		if req.GetRestartAttempt() {
+			s.cleanupAttemptLocked(key)
+		} else {
+			return &BeginSigningResponse{
+				AttemptId:        active.signerSession[:],
+				LocalPublicNonce: active.localNonce[:],
+			}, nil
+		}
+	}
+	localKey := channel.LocalChanCfg.MultiSigKey
+	remoteKey := channel.RemoteChanCfg.MultiSigKey.PubKey
+	tweaks := escrowTweaks(channel)
+	info, err := s.cfg.Signer.MuSig2CreateSession(input.MuSig2Version100RC2,
+		localKey.KeyLocator, []*btcec.PublicKey{localKey.PubKey, remoteKey}, &tweaks, nil, nil)
+	if err != nil {
+		return nil, err
+	}
+	s.attempts[key] = &signAttempt{signerSession: info.SessionID, localNonce: info.PublicNonce}
+	return &BeginSigningResponse{AttemptId: info.SessionID[:], LocalPublicNonce: info.PublicNonce[:]}, nil
+}
+
+func (s *Server) SignParent(_ context.Context, req *SignParentRequest) (*SignParentResponse, error) {
+	op, sessionID, err := parseChannelAndSession(req.GetChannelPoint(), req.GetSessionId())
+	if err != nil {
+		return nil, err
+	}
+	if len(req.GetAttemptId()) != sha256.Size || len(req.GetRemotePublicNonce()) != musig2.PubNonceSize {
+		return nil, errors.New("invalid signing attempt or public nonce length")
+	}
+	channel, err := s.cfg.ChanStateDB.FetchChannel(*op)
+	if err != nil {
+		return nil, err
+	}
+	record, err := channel.EscrowRecord()
+	if err != nil || record.SessionID != sessionID {
+		return nil, channeldb.ErrEscrowSessionMismatch
+	}
+	key := attemptKey(*op, sessionID)
+	s.mu.Lock()
+	attempt := s.attempts[key]
+	if attempt == nil || !bytes.Equal(attempt.signerSession[:], req.GetAttemptId()) {
+		s.mu.Unlock()
+		return nil, errors.New("unknown signing attempt")
+	}
+	var remoteNonce [musig2.PubNonceSize]byte
+	copy(remoteNonce[:], req.GetRemotePublicNonce())
+	if len(attempt.partial) != 0 {
+		if !attempt.acceptsRemoteNonce(remoteNonce) {
+			s.mu.Unlock()
+			return nil, errors.New("remote nonce does not match signed attempt")
+		}
+
+		partial := bytes.Clone(attempt.partial)
+		s.mu.Unlock()
+		return &SignParentResponse{LocalPartialSignature: partial}, nil
+	}
+	if attempt.hasRemoteNonce {
+		if !attempt.acceptsRemoteNonce(remoteNonce) {
+			s.mu.Unlock()
+			return nil, errors.New("remote nonce does not match signing attempt")
+		}
+	} else {
+		_, err = s.cfg.Signer.MuSig2RegisterNonces(
+			attempt.signerSession, [][musig2.PubNonceSize]byte{remoteNonce},
+		)
+		if err != nil {
+			s.cleanupAttemptLocked(key)
+			s.mu.Unlock()
+			return nil, err
+		}
+		attempt.remoteNonce = remoteNonce
+		attempt.hasRemoteNonce = true
+	}
+	hash, err := escrowSighash(record)
+	if err != nil {
+		s.cleanupAttemptLocked(key)
+		s.mu.Unlock()
+		return nil, err
+	}
+	partial, err := s.cfg.Signer.MuSig2Sign(attempt.signerSession, hash, false)
+	if err != nil {
+		s.cleanupAttemptLocked(key)
+		s.mu.Unlock()
+		return nil, err
+	}
+	encoded, err := input.SerializePartialSignature(partial)
+	if err != nil {
+		s.cleanupAttemptLocked(key)
+		s.mu.Unlock()
+		return nil, err
+	}
+	// Persist while holding the attempt lock, before making the partial public.
+	if err := channel.StoreEscrowPartial(sessionID, attempt.localNonce[:], remoteNonce[:], encoded[:]); err != nil {
+		s.cleanupAttemptLocked(key)
+		s.mu.Unlock()
+		return nil, err
+	}
+	attempt.partial = encoded[:]
+	s.mu.Unlock()
+	return &SignParentResponse{LocalPartialSignature: encoded[:]}, nil
+}
+
+func (s *Server) FinalizeParent(_ context.Context, req *FinalizeParentRequest) (
+	*FinalizeParentResponse, error) {
+
+	op, sessionID, err := parseChannelAndSession(req.GetChannelPoint(), req.GetSessionId())
+	if err != nil {
+		return nil, err
+	}
+	channel, err := s.cfg.ChanStateDB.FetchChannel(*op)
+	if err != nil {
+		return nil, err
+	}
+	record, err := channel.EscrowRecord()
+	if err != nil || record.SessionID != sessionID {
+		return nil, channeldb.ErrEscrowSessionMismatch
+	}
+	if record.Stage == channeldb.EscrowFinalized {
+		var tx wire.MsgTx
+		if err := tx.Deserialize(bytes.NewReader(record.FinalTx)); err != nil {
+			return nil, err
+		}
+		txid := tx.TxHash()
+		return &FinalizeParentResponse{RawTx: record.FinalTx, Txid: txid[:]}, nil
+	}
+	if len(req.GetRemotePartialSignature()) != input.MuSig2PartialSigSize ||
+		len(req.GetAttemptId()) != 0 && len(req.GetAttemptId()) != sha256.Size {
+
+		return nil, errors.New("invalid signing attempt or partial signature length")
+	}
+	key := attemptKey(*op, sessionID)
+	s.mu.Lock()
+	attempt := s.attempts[key]
+	remotePartial, err := input.DeserializePartialSignature(req.GetRemotePartialSignature())
+	if err != nil {
+		s.mu.Unlock()
+		return nil, err
+	}
+	var finalSig *schnorr.Signature
+	if attempt != nil && bytes.Equal(attempt.signerSession[:], req.GetAttemptId()) &&
+		len(attempt.partial) != 0 {
+
+		if err := verifyRemotePartial(channel, record, attempt, remotePartial); err != nil {
+			s.mu.Unlock()
+			return nil, err
+		}
+		var complete bool
+		finalSig, complete, err = s.cfg.Signer.MuSig2CombineSig(
+			attempt.signerSession, []*musig2.PartialSignature{remotePartial},
+		)
+		if err != nil || !complete {
+			s.cleanupAttemptLocked(key)
+			s.mu.Unlock()
+			return nil, fmt.Errorf("unable to combine escrow signature: %w", err)
+		}
+	} else {
+		finalSig, err = combinePersistedEscrowPartials(
+			channel, record, remotePartial,
+		)
+		if err != nil {
+			s.mu.Unlock()
+			return nil, err
+		}
+	}
+	tx, prevOuts, err := deserializeEscrowParent(record)
+	if err != nil {
+		s.mu.Unlock()
+		return nil, err
+	}
+	tx.TxIn[record.ChannelInputIndex].Witness = wire.TxWitness{finalSig.Serialize()}
+	if err := verifyEscrowInput(tx, prevOuts, record.ChannelInputIndex); err != nil {
+		s.cleanupAttemptLocked(key)
+		s.mu.Unlock()
+		return nil, err
+	}
+	if err := channel.FinalizeEscrowInput(sessionID, tx); err != nil {
+		s.cleanupAttemptLocked(key)
+		s.mu.Unlock()
+		return nil, err
+	}
+	s.cleanupAttemptLocked(key)
+	s.mu.Unlock()
+	var raw bytes.Buffer
+	if err := tx.Serialize(&raw); err != nil {
+		return nil, err
+	}
+	txid := tx.TxHash()
+	return &FinalizeParentResponse{RawTx: raw.Bytes(), Txid: txid[:]}, nil
+}
+
+func (s *Server) Status(_ context.Context, req *StatusRequest) (*StatusResponse, error) {
+	op, sessionID, err := parseChannelAndSession(req.GetChannelPoint(), req.GetSessionId())
+	if err != nil {
+		return nil, err
+	}
+	channel, err := s.cfg.ChanStateDB.FetchChannel(*op)
+	if err != nil {
+		return nil, err
+	}
+	record, err := channel.EscrowRecord()
+	if err != nil || record.SessionID != sessionID {
+		return nil, channeldb.ErrEscrowSessionMismatch
+	}
+	key := attemptKey(*op, sessionID)
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return statusResponse(record, s.attempts[key]), nil
+}
+
+func statusResponse(record *channeldb.EscrowRecord,
+	attempt *signAttempt) *StatusResponse {
+
+	var parentTxID []byte
+	if record.Stage >= channeldb.EscrowParentPrepared {
+		parentTxID = record.ParentTxID[:]
+	}
+
+	response := &StatusResponse{
+		Stage:                        uint32(record.Stage),
+		ParentTxid:                   parentTxID,
+		Finalized:                    record.Stage == channeldb.EscrowFinalized,
+		DurableLocalPublicNonce:      bytes.Clone(record.LocalPubNonce),
+		DurableRemotePublicNonce:     bytes.Clone(record.RemotePubNonce),
+		DurableLocalPartialSignature: bytes.Clone(record.LocalPartialSig),
+		FinalizedParentTx:            bytes.Clone(record.FinalTx),
+	}
+	if attempt != nil {
+		response.ActiveAttemptId = bytes.Clone(attempt.signerSession[:])
+		response.ActiveLocalPublicNonce = bytes.Clone(attempt.localNonce[:])
+	}
+	return response
+}
+
+func (s *Server) Cancel(_ context.Context, req *CancelRequest) (*CancelResponse, error) {
+	op, sessionID, err := parseChannelAndSession(req.GetChannelPoint(), req.GetSessionId())
+	if err != nil {
+		return nil, err
+	}
+	key := attemptKey(*op, sessionID)
+	s.mu.Lock()
+	channel, err := s.cfg.ChanStateDB.FetchChannel(*op)
+	if err != nil {
+		s.mu.Unlock()
+		return nil, err
+	}
+	if err := channel.CancelEscrow(sessionID); err != nil {
+		s.mu.Unlock()
+		return nil, err
+	}
+	s.cleanupAttemptLocked(key)
+	s.mu.Unlock()
+	if link, err := s.cfg.Switch.GetLink(lnwire.NewChanIDFromOutPoint(*op)); err == nil {
+		link.EnableAdds(htlcswitch.Incoming)
+		link.EnableAdds(htlcswitch.Outgoing)
+		link.ResumeQuiescence()
+		return &CancelResponse{LinkResumed: true}, nil
+	}
+	return &CancelResponse{LinkResumed: false}, nil
+}
+
+func parseChannelAndSession(point *ChannelPoint, session []byte) (*wire.OutPoint, [32]byte, error) {
+	var id [32]byte
+	if point == nil || len(point.GetFundingTxid()) != chainhash.HashSize || len(session) != len(id) {
+		return nil, id, errors.New("channel point and 32-byte session id are required")
+	}
+	var hash chainhash.Hash
+	copy(hash[:], point.GetFundingTxid())
+	copy(id[:], session)
+	return wire.NewOutPoint(&hash, point.GetOutputIndex()), id, nil
+}
+
+func escrowSnapshot(channel *channeldb.OpenChannel) (channeldb.EscrowSnapshot, error) {
+	local, remote, err := lnwallet.CoopCloseBalance(channel.ChanType, channel.IsInitiator, 0,
+		channel.LocalCommitment.LocalBalance.ToSatoshis(), channel.LocalCommitment.RemoteBalance.ToSatoshis(),
+		channel.LocalCommitment.CommitFee, fn.None[lntypes.ChannelParty]())
+	if err != nil {
+		return channeldb.EscrowSnapshot{}, err
+	}
+	script, _, err := input.GenTaprootFundingScript(channel.LocalChanCfg.MultiSigKey.PubKey,
+		channel.RemoteChanCfg.MultiSigKey.PubKey, 0, channel.TapscriptRoot)
+	if err != nil {
+		return channeldb.EscrowSnapshot{}, err
+	}
+	var snapshot channeldb.EscrowSnapshot
+	snapshot.Capacity, snapshot.LocalClaim, snapshot.RemoteClaim = int64(channel.Capacity), int64(local), int64(remote)
+	copy(snapshot.PeerPubKey[:], channel.IdentityPub.SerializeCompressed())
+	copy(snapshot.LocalFunding[:], channel.LocalChanCfg.MultiSigKey.PubKey.SerializeCompressed())
+	copy(snapshot.RemoteFunding[:], channel.RemoteChanCfg.MultiSigKey.PubKey.SerializeCompressed())
+	snapshot.FundingScript = script
+	return snapshot, nil
+}
+
+func freezeResponse(snapshot channeldb.EscrowSnapshot, op wire.OutPoint) *FreezeChannelResponse {
+	return &FreezeChannelResponse{CapacitySat: snapshot.Capacity, LocalClaimSat: snapshot.LocalClaim,
+		RemoteClaimSat: snapshot.RemoteClaim, PeerPubkey: snapshot.PeerPubKey[:],
+		FundingOutpoint: &ChannelPoint{FundingTxid: op.Hash[:], OutputIndex: op.Index},
+		FundingScript:   snapshot.FundingScript, LocalFundingPubkey: snapshot.LocalFunding[:], RemoteFundingPubkey: snapshot.RemoteFunding[:]}
+}
+
+func escrowTweaks(channel *channeldb.OpenChannel) input.MuSig2Tweaks {
+	tweaks := input.MuSig2Tweaks{TaprootBIP0086Tweak: true}
+	channel.TapscriptRoot.WhenSome(func(root chainhash.Hash) { tweaks = lnwallet.TapscriptRootToTweak(root) })
+	return tweaks
+}
+
+func verifyRemotePartial(channel *channeldb.OpenChannel,
+	record *channeldb.EscrowRecord, attempt *signAttempt,
+	partial *musig2.PartialSignature) error {
+
+	if !attempt.hasRemoteNonce {
+		return errors.New("remote nonce is not registered")
+	}
+
+	combinedNonce, err := musig2.AggregateNonces(
+		[][musig2.PubNonceSize]byte{
+			attempt.localNonce, attempt.remoteNonce,
+		},
+	)
+	if err != nil {
+		return fmt.Errorf("aggregate escrow nonces: %w", err)
+	}
+
+	hash, err := escrowSighash(record)
+	if err != nil {
+		return err
+	}
+
+	localKey := channel.LocalChanCfg.MultiSigKey.PubKey
+	remoteKey := channel.RemoteChanCfg.MultiSigKey.PubKey
+	keys := []*btcec.PublicKey{localKey, remoteKey}
+	signOpts := []musig2.SignOption{musig2.WithSortedKeys()}
+	if channel.TapscriptRoot.IsSome() {
+		channel.TapscriptRoot.WhenSome(func(root chainhash.Hash) {
+			signOpts = append(
+				signOpts, musig2.WithTaprootSignTweak(root[:]),
+			)
+		})
+	} else {
+		signOpts = append(signOpts, musig2.WithBip86SignTweak())
+	}
+
+	if !partial.Verify(
+		attempt.remoteNonce, combinedNonce, keys, remoteKey, hash,
+		signOpts...,
+	) {
+		return errors.New("invalid remote escrow partial signature")
+	}
+
+	return nil
+}
+
+func combinePersistedEscrowPartials(channel *channeldb.OpenChannel,
+	record *channeldb.EscrowRecord,
+	remotePartial *musig2.PartialSignature) (*schnorr.Signature, error) {
+
+	if record.Stage != channeldb.EscrowParentSigned ||
+		len(record.LocalPubNonce) != musig2.PubNonceSize ||
+		len(record.RemotePubNonce) != musig2.PubNonceSize ||
+		len(record.LocalPartialSig) != input.MuSig2PartialSigSize {
+
+		return nil, errors.New("durable signed escrow attempt required")
+	}
+	var localNonce, remoteNonce [musig2.PubNonceSize]byte
+	copy(localNonce[:], record.LocalPubNonce)
+	copy(remoteNonce[:], record.RemotePubNonce)
+	attempt := &signAttempt{
+		localNonce:     localNonce,
+		remoteNonce:    remoteNonce,
+		hasRemoteNonce: true,
+	}
+	if err := verifyRemotePartial(channel, record, attempt, remotePartial); err != nil {
+		return nil, err
+	}
+	localPartial, err := input.DeserializePartialSignature(record.LocalPartialSig)
+	if err != nil {
+		return nil, err
+	}
+	if err := verifyLocalPartial(channel, record, attempt, localPartial); err != nil {
+		return nil, err
+	}
+	combinedNonce, err := musig2.AggregateNonces(
+		[][musig2.PubNonceSize]byte{localNonce, remoteNonce},
+	)
+	if err != nil {
+		return nil, fmt.Errorf("aggregate escrow nonces: %w", err)
+	}
+	hash, err := escrowSighash(record)
+	if err != nil {
+		return nil, err
+	}
+	localKey := channel.LocalChanCfg.MultiSigKey.PubKey
+	remoteKey := channel.RemoteChanCfg.MultiSigKey.PubKey
+	keys := []*btcec.PublicKey{localKey, remoteKey}
+	keyOptions := []musig2.KeyAggOption{}
+	combineOptions := []musig2.CombineOption{}
+	if channel.TapscriptRoot.IsSome() {
+		channel.TapscriptRoot.WhenSome(func(root chainhash.Hash) {
+			keyOptions = append(keyOptions, musig2.WithTaprootKeyTweak(root[:]))
+			combineOptions = append(
+				combineOptions,
+				musig2.WithTaprootTweakedCombine(hash, keys, root[:], true),
+			)
+		})
+	} else {
+		keyOptions = append(keyOptions, musig2.WithBIP86KeyTweak())
+		combineOptions = append(
+			combineOptions, musig2.WithBip86TweakedCombine(hash, keys, true),
+		)
+	}
+	combinedKey, _, _, err := musig2.AggregateKeys(keys, true, keyOptions...)
+	if err != nil {
+		return nil, fmt.Errorf("aggregate escrow keys: %w", err)
+	}
+	finalNonce, err := escrowFinalNonce(combinedNonce, combinedKey.FinalKey, hash)
+	if err != nil {
+		return nil, err
+	}
+	return musig2.CombineSigs(
+		finalNonce,
+		[]*musig2.PartialSignature{localPartial, remotePartial},
+		combineOptions...,
+	), nil
+}
+
+func verifyLocalPartial(channel *channeldb.OpenChannel,
+	record *channeldb.EscrowRecord, attempt *signAttempt,
+	partial *musig2.PartialSignature) error {
+
+	localKey := channel.LocalChanCfg.MultiSigKey.PubKey
+	remoteKey := channel.RemoteChanCfg.MultiSigKey.PubKey
+	combinedNonce, err := musig2.AggregateNonces(
+		[][musig2.PubNonceSize]byte{attempt.localNonce, attempt.remoteNonce},
+	)
+	if err != nil {
+		return fmt.Errorf("aggregate escrow nonces: %w", err)
+	}
+	hash, err := escrowSighash(record)
+	if err != nil {
+		return err
+	}
+	signOptions := []musig2.SignOption{musig2.WithSortedKeys()}
+	if channel.TapscriptRoot.IsSome() {
+		channel.TapscriptRoot.WhenSome(func(root chainhash.Hash) {
+			signOptions = append(signOptions, musig2.WithTaprootSignTweak(root[:]))
+		})
+	} else {
+		signOptions = append(signOptions, musig2.WithBip86SignTweak())
+	}
+	if !partial.Verify(
+		attempt.localNonce, combinedNonce,
+		[]*btcec.PublicKey{localKey, remoteKey}, localKey, hash,
+		signOptions...,
+	) {
+		return errors.New("invalid durable local escrow partial signature")
+	}
+	return nil
+}
+
+func escrowFinalNonce(combinedNonce [musig2.PubNonceSize]byte,
+	combinedKey *btcec.PublicKey, hash [sha256.Size]byte) (*btcec.PublicKey, error) {
+
+	var nonceMessage bytes.Buffer
+	nonceMessage.Write(combinedNonce[:])
+	nonceMessage.Write(schnorr.SerializePubKey(combinedKey))
+	nonceMessage.Write(hash[:])
+	blindHash := chainhash.TaggedHash(musig2.NonceBlindTag, nonceMessage.Bytes())
+	var blinder btcec.ModNScalar
+	blinder.SetByteSlice(blindHash[:])
+	r1, err := btcec.ParseJacobian(combinedNonce[:btcec.PubKeyBytesLenCompressed])
+	if err != nil {
+		return nil, err
+	}
+	r2, err := btcec.ParseJacobian(combinedNonce[btcec.PubKeyBytesLenCompressed:])
+	if err != nil {
+		return nil, err
+	}
+	var nonce btcec.JacobianPoint
+	btcec.ScalarMultNonConst(&blinder, &r2, &r2)
+	btcec.AddNonConst(&r1, &r2, &nonce)
+	if nonce.Z.IsZero() {
+		btcec.GeneratorJacobian(&nonce)
+	} else {
+		nonce.ToAffine()
+	}
+	return btcec.NewPublicKey(&nonce.X, &nonce.Y), nil
+}
+
+func (s *Server) publishFinalized(channel *channeldb.OpenChannel,
+	op wire.OutPoint, tx *wire.MsgTx) error {
+
+	s.cfg.Switch.RemoveLink(lnwire.NewChanIDFromOutPoint(op))
+	shortChanID := channel.ShortChanID()
+	label := labels.MakeLabel(labels.LabelTypeChannelClose, &shortChanID)
+	if err := s.cfg.PublishTransaction(tx, label); err != nil {
+		return fmt.Errorf("publish escrow parent: %w", err)
+	}
+
+	return nil
+}
+
+func validateParent(channel *channeldb.OpenChannel, raw []byte, rpcPrevOuts []*PrevOut,
+	channelIndex uint32) (*wire.MsgTx, []channeldb.EscrowPrevOut, error) {
+
+	var tx wire.MsgTx
+	r := bytes.NewReader(raw)
+	if err := tx.Deserialize(r); err != nil || r.Len() != 0 {
+		return nil, nil, errors.New("invalid raw parent transaction")
+	}
+	if err := blockchain.CheckTransactionSanity(btcutil.NewTx(&tx)); err != nil {
+		return nil, nil, err
+	}
+	if len(tx.TxIn) != len(rpcPrevOuts) || int(channelIndex) >= len(tx.TxIn) {
+		return nil, nil, errors.New("prevout count or channel input index is invalid")
+	}
+	funding, err := escrowSnapshot(channel)
+	if err != nil {
+		return nil, nil, err
+	}
+	seen := make(map[wire.OutPoint]struct{}, len(tx.TxIn))
+	prevOuts := make([]channeldb.EscrowPrevOut, len(rpcPrevOuts))
+	var inputSum, outputSum int64
+	for i, txIn := range tx.TxIn {
+		if len(txIn.SignatureScript) != 0 {
+			return nil, nil, errors.New("parent inputs must have empty scriptSig")
+		}
+		if _, ok := seen[txIn.PreviousOutPoint]; ok {
+			return nil, nil, errors.New("duplicate parent input")
+		}
+		seen[txIn.PreviousOutPoint] = struct{}{}
+		prev := rpcPrevOuts[i]
+		if prev == nil || prev.ValueSat < 0 || !txscript.IsWitnessProgram(prev.PkScript) {
+			return nil, nil, errors.New("parent prevout is not a native witness output")
+		}
+		if inputSum > int64(^uint64(0)>>1)-prev.ValueSat {
+			return nil, nil, errors.New("parent input value overflow")
+		}
+		inputSum += prev.ValueSat
+		prevOuts[i] = channeldb.EscrowPrevOut{Value: prev.ValueSat, PkScript: bytes.Clone(prev.PkScript)}
+	}
+	for _, out := range tx.TxOut {
+		if out.Value < 0 || outputSum > int64(^uint64(0)>>1)-out.Value {
+			return nil, nil, errors.New("parent output value is invalid")
+		}
+		outputSum += out.Value
+	}
+	if outputSum > inputSum {
+		return nil, nil, errors.New("parent outputs exceed inputs")
+	}
+	channelInput := tx.TxIn[channelIndex]
+	if channelInput.PreviousOutPoint != channel.FundingOutpoint || len(channelInput.Witness) != 0 ||
+		prevOuts[channelIndex].Value != funding.Capacity || !bytes.Equal(prevOuts[channelIndex].PkScript, funding.FundingScript) {
+		return nil, nil, errors.New("channel input does not exactly match funding output")
+	}
+	return &tx, prevOuts, nil
+}
+
+func deserializeEscrowParent(record *channeldb.EscrowRecord) (*wire.MsgTx, []channeldb.EscrowPrevOut, error) {
+	var tx wire.MsgTx
+	r := bytes.NewReader(record.ParentTx)
+	if err := tx.Deserialize(r); err != nil || r.Len() != 0 || int(record.ChannelInputIndex) >= len(tx.TxIn) || len(tx.TxIn) != len(record.PrevOuts) {
+		return nil, nil, errors.New("invalid stored escrow parent")
+	}
+	return &tx, record.PrevOuts, nil
+}
+
+func escrowSighash(record *channeldb.EscrowRecord) ([sha256.Size]byte, error) {
+	tx, prevOuts, err := deserializeEscrowParent(record)
+	if err != nil {
+		return [sha256.Size]byte{}, err
+	}
+	fetcher := txscript.NewMultiPrevOutFetcher(nil)
+	for i, prev := range prevOuts {
+		fetcher.AddPrevOut(tx.TxIn[i].PreviousOutPoint, &wire.TxOut{Value: prev.Value, PkScript: prev.PkScript})
+	}
+	hashes := txscript.NewTxSigHashes(tx, fetcher)
+	hash, err := txscript.CalcTaprootSignatureHash(hashes, txscript.SigHashDefault, tx, int(record.ChannelInputIndex), fetcher)
+	if err != nil {
+		return [sha256.Size]byte{}, err
+	}
+	var result [sha256.Size]byte
+	copy(result[:], hash)
+	return result, nil
+}
+
+func verifyEscrowParent(tx *wire.MsgTx, prevOuts []channeldb.EscrowPrevOut) error {
+	fetcher := txscript.NewMultiPrevOutFetcher(nil)
+	for i, prev := range prevOuts {
+		fetcher.AddPrevOut(tx.TxIn[i].PreviousOutPoint, &wire.TxOut{Value: prev.Value, PkScript: prev.PkScript})
+	}
+	hashes := txscript.NewTxSigHashes(tx, fetcher)
+	for i, prev := range prevOuts {
+		vm, err := txscript.NewEngine(prev.PkScript, tx, i, txscript.StandardVerifyFlags, nil, hashes, prev.Value, fetcher)
+		if err != nil {
+			return err
+		}
+		if err := vm.Execute(); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func verifyEscrowInput(tx *wire.MsgTx, prevOuts []channeldb.EscrowPrevOut,
+	channelInputIndex uint32) error {
+
+	if tx == nil || len(tx.TxIn) != len(prevOuts) ||
+		int(channelInputIndex) >= len(tx.TxIn) {
+
+		return errors.New("invalid escrow parent input set")
+	}
+	fetcher := txscript.NewMultiPrevOutFetcher(nil)
+	for i, prev := range prevOuts {
+		fetcher.AddPrevOut(tx.TxIn[i].PreviousOutPoint, &wire.TxOut{
+			Value: prev.Value, PkScript: prev.PkScript,
+		})
+	}
+	hashes := txscript.NewTxSigHashes(tx, fetcher)
+	index := int(channelInputIndex)
+	prev := prevOuts[index]
+	vm, err := txscript.NewEngine(
+		prev.PkScript, tx, index, txscript.StandardVerifyFlags, nil,
+		hashes, prev.Value, fetcher,
+	)
+	if err != nil {
+		return err
+	}
+	return vm.Execute()
+}
+
+func attemptKey(op wire.OutPoint, sessionID [32]byte) string {
+	return op.String() + string(sessionID[:])
+}
