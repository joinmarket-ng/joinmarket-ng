+func TestSignedAttemptRequiresSameRemoteNonce(t *testing.T) {
+	t.Parallel()
+
+	var nonce [musig2.PubNonceSize]byte
+	nonce[0] = 1
+	attempt := &signAttempt{
+		remoteNonce:    nonce,
+		hasRemoteNonce: true,
+		partial:        bytes.Repeat([]byte{1}, 32),
+	}
+	require.True(t, attempt.acceptsRemoteNonce(nonce))
+	otherNonce := nonce
+	otherNonce[0]++
+	require.False(t, attempt.acceptsRemoteNonce(otherNonce))
+	require.Len(t, attempt.partial, 32)
+}
