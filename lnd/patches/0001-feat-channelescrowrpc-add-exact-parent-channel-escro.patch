+		mac, err := cfg.MacService.NewMacaroon(
+			context.Background(), macaroons.DefaultRootKeyID, macaroonOps...,
+		)
+		if err != nil {
+			return nil, nil, err
+		}
+		data, err := mac.M().MarshalBinary()
+		if err != nil {
+			return nil, nil, err
+		}
+		if err := os.WriteFile(cfg.ChannelEscrowMacPath, data, 0600); err != nil {
+			return nil, nil, err
+		}
+	}
+	return &Server{cfg: cfg, attempts: make(map[string]*signAttempt)}, macPermissions, nil
+}
+
+func (s *Server) Start() error { return nil }
+
+func (s *Server) Stop() error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	for key := range s.attempts {
+		s.cleanupAttemptLocked(key)
+	}
+
+	return nil
+}
+
+func (s *Server) Name() string { return subServerName }
+
+// cleanupAttemptLocked removes an attempt and destroys its signer session.
+// The caller must hold s.mu.
+func (s *Server) cleanupAttemptLocked(key string) {
+	attempt := s.attempts[key]
+	if attempt == nil {
+		return
+	}
+
+	delete(s.attempts, key)
+	_ = s.cfg.Signer.MuSig2Cleanup(attempt.signerSession)
+}
