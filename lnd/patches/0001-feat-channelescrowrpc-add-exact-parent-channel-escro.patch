+func TestQuiescenceResumeCancelsPendingRequest(t *testing.T) {
+	t.Parallel()
+
+	harness := initQuiescerTestHarness(lntypes.Local)
+	stfuReq, stfuRes := fn.NewReq[fn.Unit, fn.Result[lntypes.ChannelParty]](
+		fn.Unit{},
+	)
+	harness.quiescer.InitStfu(stfuReq)
+	harness.quiescer.Resume()
+
+	select {
+	case result := <-stfuRes:
+		_, err := result.Unpack()
+		require.ErrorIs(t, err, ErrQuiescenceCanceled)
+	default:
+		t.Fatal("pending quiescence request not canceled")
+	}
+
+	replacement, _ := fn.NewReq[fn.Unit, fn.Result[lntypes.ChannelParty]](
+		fn.Unit{},
+	)
+	harness.quiescer.InitStfu(replacement)
+	require.NoError(t, harness.quiescer.SendOwedStfu())
