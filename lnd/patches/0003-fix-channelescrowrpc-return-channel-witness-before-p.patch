From a445cad7a58f4c38065e1d86a49a9b7c8532fc36 Mon Sep 17 00:00:00 2001
From: m0wer <m0wer@sgn.space>
Date: Sun, 16 Aug 2026 18:08:31 +0200
Subject: [PATCH] fix(channelescrowrpc): return channel witness before publish

Finalize and persist only the exact channel input witness so CoinJoin can collect the remaining input signatures before broadcast.

Changelog: Support channel-input signing in multi-party CoinJoin transactions
---
 channeldb/channel_escrow.go           | 21 +++++----------
 channeldb/channel_escrow_test.go      | 19 +++++++-------
 lnrpc/channelescrowrpc/server.go      | 37 +++++++++++++++++++++------
 lnrpc/channelescrowrpc/server_test.go | 18 +++++++++----
 peer/brontide.go                      |  2 +-
 5 files changed, 58 insertions(+), 39 deletions(-)

diff --git a/channeldb/channel_escrow.go b/channeldb/channel_escrow.go
index 1d4894b..e4194ce 100644
--- a/channeldb/channel_escrow.go
+++ b/channeldb/channel_escrow.go
@@ -10,7 +10,6 @@ import (
 	"github.com/btcsuite/btcd/chaincfg/chainhash"
 	"github.com/btcsuite/btcd/wire"
 	"github.com/lightningnetwork/lnd/kvdb"
-	"github.com/lightningnetwork/lnd/lntypes"
 )
 
 var (
@@ -223,11 +222,11 @@ func (c *OpenChannel) CancelEscrow(sessionID [32]byte) error {
 	})
 }
 
-// FinalizeEscrowCoop atomically records the final parent and the regular
-// cooperative-close broadcast record, preserving the escrow lock for audit and
-// exact-spend classification.
-func (c *OpenChannel) FinalizeEscrowCoop(sessionID [32]byte, closeTx *wire.MsgTx,
-	closer lntypes.ChannelParty) error {
+// FinalizeEscrowInput atomically records the parent with its finalized channel
+// input witness, preserving the escrow lock for audit and exact-spend
+// classification. Other CoinJoin input witnesses may still be absent, so this
+// does not mark the transaction broadcast or schedule it for publication.
+func (c *OpenChannel) FinalizeEscrowInput(sessionID [32]byte, closeTx *wire.MsgTx) error {
 
 	if closeTx == nil {
 		return errors.New("nil escrow cooperative transaction")
@@ -258,15 +257,7 @@ func (c *OpenChannel) FinalizeEscrowCoop(sessionID [32]byte, closeTx *wire.MsgTx
 		if err := putEscrowRecord(bucket, record); err != nil {
 			return err
 		}
-		if err := bucket.Put(coopCloseTxKey, txBuf.Bytes()); err != nil {
-			return err
-		}
-		channel.chanStatus |= ChanStatusCoopBroadcasted | ChanStatusEscrowLocked
-		if closer.IsLocal() {
-			channel.chanStatus |= ChanStatusLocalCloseInitiator
-		} else {
-			channel.chanStatus |= ChanStatusRemoteCloseInitiator
-		}
+		channel.chanStatus |= ChanStatusEscrowLocked
 		return putOpenChannel(bucket, channel)
 	})
 }
