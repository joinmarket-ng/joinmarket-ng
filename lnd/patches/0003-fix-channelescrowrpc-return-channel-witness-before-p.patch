+	require.NoError(t, reloaded.FinalizeEscrowInput(prepared.SessionID, &parent))
+	require.False(t, reloaded.HasChanStatus(ChanStatusCoopBroadcasted))
+	_, err = reloaded.BroadcastedCooperative()
+	require.ErrorIs(t, err, ErrNoCloseTx)
+	require.NoError(t, reloaded.FinalizeEscrowInput(prepared.SessionID, &parent))
 	parent.TxOut[0].Value++
-	require.ErrorIs(t, reloaded.FinalizeEscrowCoop(
-		prepared.SessionID, &parent, lntypes.Local,
-	), ErrEscrowMutation)
+	require.ErrorIs(
+		t, reloaded.FinalizeEscrowInput(prepared.SessionID, &parent),
+		ErrEscrowMutation,
+	)
 }
 
 func TestEscrowCancelAndStatusString(t *testing.T) {
diff --git a/lnrpc/channelescrowrpc/server.go b/lnrpc/channelescrowrpc/server.go
index fa3fe41..2986f51 100644
--- a/lnrpc/channelescrowrpc/server.go
+++ b/lnrpc/channelescrowrpc/server.go
@@ -432,9 +432,6 @@ func (s *Server) FinalizeParent(_ context.Context, req *FinalizeParentRequest) (
 			return nil, err
 		}
 		txid := tx.TxHash()
-		if err := s.publishFinalized(channel, *op, &tx); err != nil {
-			return nil, err
-		}
 		return &FinalizeParentResponse{RawTx: record.FinalTx, Txid: txid[:]}, nil
 	}
 	if len(req.GetAttemptId()) != sha256.Size || len(req.GetRemotePartialSignature()) != input.MuSig2PartialSigSize {
@@ -468,21 +465,18 @@ func (s *Server) FinalizeParent(_ context.Context, req *FinalizeParentRequest) (
 		return nil, err
 	}
 	tx.TxIn[record.ChannelInputIndex].Witness = wire.TxWitness{finalSig.Serialize()}
-	if err := verifyEscrowParent(tx, prevOuts); err != nil {
+	if err := verifyEscrowInput(tx, prevOuts, record.ChannelInputIndex); err != nil {
 		s.cleanupAttemptLocked(key)
 		s.mu.Unlock()
 		return nil, err
 	}
-	if err := channel.FinalizeEscrowCoop(sessionID, tx, lntypes.Local); err != nil {
+	if err := channel.FinalizeEscrowInput(sessionID, tx); err != nil {
 		s.cleanupAttemptLocked(key)
 		s.mu.Unlock()
 		return nil, err
 	}
 	s.cleanupAttemptLocked(key)
 	s.mu.Unlock()
-	if err := s.publishFinalized(channel, *op, tx); err != nil {
-		return nil, err
-	}
 	var raw bytes.Buffer
 	if err := tx.Serialize(&raw); err != nil {
 		return nil, err
@@ -753,6 +747,33 @@ func verifyEscrowParent(tx *wire.MsgTx, prevOuts []channeldb.EscrowPrevOut) erro
 	return nil
 }
 
+func verifyEscrowInput(tx *wire.MsgTx, prevOuts []channeldb.EscrowPrevOut,
+	channelInputIndex uint32) error {
+
+	if tx == nil || len(tx.TxIn) != len(prevOuts) ||
+		int(channelInputIndex) >= len(tx.TxIn) {
+
+		return errors.New("invalid escrow parent input set")
+	}
+	fetcher := txscript.NewMultiPrevOutFetcher(nil)
+	for i, prev := range prevOuts {
+		fetcher.AddPrevOut(tx.TxIn[i].PreviousOutPoint, &wire.TxOut{
+			Value: prev.Value, PkScript: prev.PkScript,
+		})
+	}
+	hashes := txscript.NewTxSigHashes(tx, fetcher)
+	index := int(channelInputIndex)
+	prev := prevOuts[index]
+	vm, err := txscript.NewEngine(
+		prev.PkScript, tx, index, txscript.StandardVerifyFlags, nil,
+		hashes, prev.Value, fetcher,
+	)
+	if err != nil {
+		return err
+	}
+	return vm.Execute()
+}
+
 func attemptKey(op wire.OutPoint, sessionID [32]byte) string {
 	return op.String() + string(sessionID[:])
 }
