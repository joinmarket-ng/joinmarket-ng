+// EscrowAuthorizer returns the channel's enrolled BIP340 x-only authorizer.
+func (c *OpenChannel) EscrowAuthorizer() ([32]byte, error) {
+	var key [32]byte
+	err := kvdb.View(c.Db.backend, func(tx kvdb.RTx) error {
+		bucket, err := fetchChanBucket(
+			tx, c.IdentityPub, &c.FundingOutpoint, c.ChainHash,
+		)
+		if err != nil {
+			return err
+		}
+		key, err = escrowAuthorizerFromBucket(bucket)
+		return err
+	}, func() { key = [32]byte{} })
+	return key, err
+}
+
+// AuthorizeEscrow enrolls the channel for escrow under an authorizer key.
+// Re-enrolling the same key is idempotent at any time. A channel without an
+// authorizer may be enrolled even while it has an escrow record, so a session
+// begun before enrollment existed can continue. Any other change is refused
+// while an escrow record exists.
+func (c *OpenChannel) AuthorizeEscrow(authorizer [32]byte) error {
+	return c.updateEscrow(func(channel *OpenChannel, bucket kvdb.RwBucket) error {
+		current, err := escrowAuthorizerFromBucket(bucket)
+		switch {
+		case err == nil && current == authorizer:
+			return nil
+		case err == nil:
+			if bucket.Get(escrowRecordKey) != nil {
+				return ErrEscrowAuthorizerLocked
+			}
+		case !errors.Is(err, ErrNoEscrowAuthorizer):
+			return err
+		}
+		encoded := make([]byte, 0, 33)
+		encoded = append(encoded, escrowAuthorizerVersion)
+		encoded = append(encoded, authorizer[:]...)
+		return bucket.Put(escrowAuthorizerKey, encoded)
+	})
+}
+
+// RevokeEscrowAuthorizer removes the channel's enrollment. It is refused while
+// an escrow record exists and is idempotent otherwise.
+func (c *OpenChannel) RevokeEscrowAuthorizer() error {
+	return c.updateEscrow(func(channel *OpenChannel, bucket kvdb.RwBucket) error {
+		if bucket.Get(escrowRecordKey) != nil {
+			return ErrEscrowAuthorizerLocked
+		}
+		if bucket.Get(escrowAuthorizerKey) == nil {
+			return nil
+		}
+		return bucket.Delete(escrowAuthorizerKey)
+	})
+}
+
+func escrowAuthorizerFromBucket(bucket kvdb.RBucket) ([32]byte, error) {
+	var key [32]byte
+	data := bucket.Get(escrowAuthorizerKey)
+	if data == nil {
+		return key, ErrNoEscrowAuthorizer
+	}
+	if len(data) != 33 || data[0] != escrowAuthorizerVersion {
+		return key, errors.New("unknown escrow authorizer record")
+	}
+	copy(key[:], data[1:])
+	return key, nil
+}
