@@ -0,0 +1,167 @@
+//go:build channelescrowrpc
+// +build channelescrowrpc
+
+package channelescrowrpc
+
+import (
+	"bytes"
+	"encoding/hex"
+	"testing"
+
+	"github.com/btcsuite/btcd/btcec/v2"
+	"github.com/btcsuite/btcd/btcec/v2/schnorr"
+	"github.com/btcsuite/btcd/chaincfg"
+	"github.com/btcsuite/btcd/chaincfg/chainhash"
+	"github.com/btcsuite/btcd/wire"
+	"github.com/lightningnetwork/lnd/channeldb"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// authorizationVector is shared with the Python authorizer tests
+// (jmcore/tests/test_escrow_authorizer.py); both must produce vectorDigest.
+type authorizationVector struct {
+	chain  chainhash.Hash
+	node   [33]byte
+	op     wire.OutPoint
+	record *channeldb.EscrowRecord
+}
+
+const vectorDigest = "bb38a59c038d846870187ec7a70c97dd8f676daff2cb857aa3bf748a573a7c29"
+
+func testAuthorizationVector() authorizationVector {
+	var node [33]byte
+	node[0] = 2
+	copy(node[1:], bytes.Repeat([]byte{0x11}, 32))
+	var opHash chainhash.Hash
+	copy(opHash[:], bytes.Repeat([]byte{0x33}, 32))
+	var session [32]byte
+	copy(session[:], bytes.Repeat([]byte{0x44}, 32))
+	return authorizationVector{
+		chain: *chaincfg.RegressionNetParams.GenesisHash,
+		node:  node,
+		op:    wire.OutPoint{Hash: opHash, Index: 1},
+		record: &channeldb.EscrowRecord{
+			SessionID: session,
+			Stage:     channeldb.EscrowParentPrepared,
+			ParentTx:  []byte("exact parent transaction bytes"),
+			PrevOuts: []channeldb.EscrowPrevOut{
+				{Value: 1_000, PkScript: append([]byte{0x00, 0x14}, bytes.Repeat([]byte{0x55}, 20)...)},
+				{Value: 2_000, PkScript: append([]byte{0x51, 0x20}, bytes.Repeat([]byte{0x66}, 32)...)},
+			},
+			ChannelInputIndex: 1,
+		},
+	}
+}
+
+func (v authorizationVector) digest() *chainhash.Hash {
+	return authorizationDigest(AuthorizationPolicyV1, v.chain, v.node, v.op, v.record)
+}
+
+func TestAuthorizationDigestVector(t *testing.T) {
+	t.Parallel()
+
+	require.Equal(t, vectorDigest, hex.EncodeToString(testAuthorizationVector().digest()[:]))
+}
+
+func TestAuthorizationDigestCommitsToEveryField(t *testing.T) {
+	t.Parallel()
+
+	base := testAuthorizationVector().digest()
+	mutations := map[string]func(*authorizationVector){
+		"chain": func(v *authorizationVector) { v.chain = *chaincfg.TestNet3Params.GenesisHash },
+		"node":  func(v *authorizationVector) { v.node[1] ^= 1 },
+		"txid":  func(v *authorizationVector) { v.op.Hash[0] ^= 1 },
+		"vout":  func(v *authorizationVector) { v.op.Index++ },
+		"session": func(v *authorizationVector) {
+			v.record.SessionID[0] ^= 1
+		},
+		"parent": func(v *authorizationVector) {
+			v.record.ParentTx = append(bytes.Clone(v.record.ParentTx), 0)
+		},
+		"prevout value": func(v *authorizationVector) { v.record.PrevOuts[0].Value++ },
+		"prevout script": func(v *authorizationVector) {
+			v.record.PrevOuts[1].PkScript = append(bytes.Clone(v.record.PrevOuts[1].PkScript), 0)
+		},
+		"prevout order": func(v *authorizationVector) {
+			p := v.record.PrevOuts
+			v.record.PrevOuts = []channeldb.EscrowPrevOut{p[1], p[0]}
+		},
+		"input index": func(v *authorizationVector) { v.record.ChannelInputIndex = 0 },
+	}
+	for name, mutate := range mutations {
+		v := testAuthorizationVector()
+		mutate(&v)
+		require.NotEqual(t, base, v.digest(), name)
+	}
+	v := testAuthorizationVector()
+	require.NotEqual(t, base, authorizationDigest(2, v.chain, v.node, v.op, v.record))
+}
+
+func TestCheckAuthorization(t *testing.T) {
+	t.Parallel()
+
+	priv, _ := btcec.PrivKeyFromBytes(bytes.Repeat([]byte{1}, 32))
+	var authorizer [32]byte
+	copy(authorizer[:], schnorr.SerializePubKey(priv.PubKey()))
+	digest := testAuthorizationVector().digest()
+	sig, err := schnorr.Sign(priv, digest[:])
+	require.NoError(t, err)
+
+	require.NoError(t, checkAuthorization(authorizer, digest, sig.Serialize()))
+
+	denied := func(err error) {
+		t.Helper()
+		require.Equal(t, codes.PermissionDenied, status.Code(err))
+	}
+	other := testAuthorizationVector()
+	other.record.ChannelInputIndex = 0
+	denied(checkAuthorization(authorizer, other.digest(), sig.Serialize()))
+	denied(checkAuthorization(authorizer, digest, sig.Serialize()[:63]))
+	denied(checkAuthorization(authorizer, digest, nil))
+	otherPriv, _ := btcec.PrivKeyFromBytes(bytes.Repeat([]byte{2}, 32))
+	var otherKey [32]byte
+	copy(otherKey[:], schnorr.SerializePubKey(otherPriv.PubKey()))
+	denied(checkAuthorization(otherKey, digest, sig.Serialize()))
+}
+
+func TestVerifyAuthorizationRejectsBeforeKeyLookup(t *testing.T) {
+	t.Parallel()
+
+	// These checks run before the enrolled key is read, so a channel with no
+	// database is enough.
+	server := &Server{cfg: &Config{LocalNodeKey: func() [33]byte { return [33]byte{2} }}}
+	v := testAuthorizationVector()
+	sig := bytes.Repeat([]byte{1}, schnorr.SignatureSize)
+
+	_, err := server.verifyAuthorization(nil, v.op, v.record, 0, sig)
+	require.Equal(t, codes.InvalidArgument, status.Code(err))
+	_, err = server.verifyAuthorization(nil, v.op, v.record, 2, sig)
+	require.Equal(t, codes.InvalidArgument, status.Code(err))
+
+	locked := *v.record
+	locked.Stage = channeldb.EscrowLocked
+	_, err = server.verifyAuthorization(nil, v.op, &locked, AuthorizationPolicyV1, sig)
+	require.Equal(t, codes.FailedPrecondition, status.Code(err))
+
+	_, err = server.verifyAuthorization(nil, v.op, v.record, AuthorizationPolicyV1, sig[:10])
+	require.Equal(t, codes.PermissionDenied, status.Code(err))
+}
+
+func TestEnrollmentNeedsOffchainWrite(t *testing.T) {
+	t.Parallel()
+
+	for _, method := range []string{"AuthorizeChannel", "RevokeChannel"} {
+		ops := macPermissions["/channelescrowrpc.ChannelEscrow/"+method]
+		require.Len(t, ops, 1, method)
+		require.Equal(t, "offchain", ops[0].Entity, method)
+		require.Equal(t, "write", ops[0].Action, method)
+	}
+	// The escrow macaroon itself must not carry enrollment authority.
+	for _, op := range macaroonOps {
+		require.Equal(t, "channelescrow", op.Entity)
+	}
+	require.Equal(t, "read",
+		macPermissions["/channelescrowrpc.ChannelEscrow/PolicyInfo"][0].Action)
+}
