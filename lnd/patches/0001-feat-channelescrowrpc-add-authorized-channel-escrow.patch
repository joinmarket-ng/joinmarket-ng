+package channeldb
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+
+	"github.com/btcsuite/btcd/chaincfg/chainhash"
+	"github.com/btcsuite/btcd/wire"
+	"github.com/lightningnetwork/lnd/kvdb"
+)
+
+var (
+	// ErrNoEscrowRecord is returned when a channel has no escrow state.
+	ErrNoEscrowRecord = errors.New("channel has no escrow record")
+
+	// ErrEscrowSessionMismatch is returned for a request that does not own the
+	// existing escrow lock.
+	ErrEscrowSessionMismatch = errors.New("escrow session does not match lock")
+
+	// ErrEscrowMutation is returned when an immutable escrow parent is changed.
+	ErrEscrowMutation = errors.New("escrow parent mutation rejected")
+
+	// ErrEscrowAlreadySigned is returned when an operation would unlock or
+	// mutate an escrow after releasing a local partial signature.
+	ErrEscrowAlreadySigned = errors.New("escrow has released a local signature")
+
+	// ErrNoEscrowAuthorizer is returned when a channel has not been enrolled
+	// for escrow with an authorizer key.
+	ErrNoEscrowAuthorizer = errors.New("channel has no escrow authorizer")
+
+	// ErrEscrowAuthorizerLocked is returned when an enrolled authorizer
+	// would change while escrow state exists for the channel.
+	ErrEscrowAuthorizerLocked = errors.New("escrow authorizer cannot change " +
+		"while an escrow record exists")
+)
+
+var escrowRecordKey = []byte("channel-escrow-v1")
+var escrowCancellationKey = []byte("channel-escrow-canceled-v1")
+
+// escrowAuthorizerKey stores the BIP340 x-only key whose signature is
+// required for every new escrow partial signature of the channel.
+var escrowAuthorizerKey = []byte("channel-escrow-auth-v1")
+
+const (
+	escrowEncodingVersion   byte = 1
+	escrowAuthorizerVersion byte = 1
+	maxEscrowBlobSize            = 4 * 1024 * 1024
+	maxEscrowRecordSize          = 8 * 1024 * 1024
+)
+
+// EscrowStage describes the durable part of the escrow protocol.
+type EscrowStage uint8
+
+const (
+	EscrowLocked EscrowStage = iota
+	EscrowParentPrepared
+	EscrowParentSigned
+	EscrowFinalized
+)
+
+// EscrowPrevOut is a parent transaction prevout. Prevouts are kept in input
+// order because BIP341 commits to the complete set.
+type EscrowPrevOut struct {
+	Value    int64
+	PkScript []byte
+}
+
+// EscrowSnapshot is the stable FreezeChannel response persisted with the lock.
+// Amounts are satoshis.
+type EscrowSnapshot struct {
+	Capacity      int64
+	LocalClaim    int64
+	RemoteClaim   int64
+	PeerPubKey    [33]byte
+	FundingScript []byte
+	LocalFunding  [33]byte
+	RemoteFunding [33]byte
+}
+
+// EscrowRecord is the complete durable authorization for a parent spend. It
+// deliberately contains no private nonce or MuSig2 session state.
+type EscrowRecord struct {
+	SessionID         [32]byte
+	Stage             EscrowStage
+	Snapshot          EscrowSnapshot
+	ParentTx          []byte
+	PrevOuts          []EscrowPrevOut
+	ChannelInputIndex uint32
+	ParentTxID        chainhash.Hash
+	LocalPubNonce     []byte
+	RemotePubNonce    []byte
+	LocalPartialSig   []byte
+	FinalTx           []byte
+
+	// PolicyVersion is the authorization policy that admitted the latest
+	// local partial signature. Zero means it has not been signed yet.
+	PolicyVersion uint32
+}
+
+// EscrowRecord returns a copy of the channel's durable escrow authorization.
+func (c *OpenChannel) EscrowRecord() (*EscrowRecord, error) {
+	var record *EscrowRecord
+	err := kvdb.View(c.Db.backend, func(tx kvdb.RTx) error {
+		bucket, err := fetchChanBucket(
+			tx, c.IdentityPub, &c.FundingOutpoint, c.ChainHash,
+		)
+		if err != nil {
+			return err
+		}
+		data := bucket.Get(escrowRecordKey)
+		if data == nil {
+			return ErrNoEscrowRecord
+		}
+		record, err = decodeEscrowRecord(data)
+		return err
+	}, func() { record = nil })
+	if err != nil {
+		return nil, err
+	}
+	return record, nil
+}
+
+// LockEscrow atomically writes a new escrow authorization and locks a channel.
+// A retry with the same session and snapshot is idempotent.
+func (c *OpenChannel) LockEscrow(record *EscrowRecord) error {
+	if record == nil || record.Stage != EscrowLocked {
+		return fmt.Errorf("invalid initial escrow record")
+	}
+	return c.updateEscrow(func(channel *OpenChannel, bucket kvdb.RwBucket) error {
+		if bytes.Equal(bucket.Get(escrowCancellationKey), record.SessionID[:]) {
+			return ErrEscrowSessionMismatch
+		}
+		existing := bucket.Get(escrowRecordKey)
+		if existing != nil {
+			current, err := decodeEscrowRecord(existing)
+			if err != nil {
+				return err
+			}
+			if current.SessionID != record.SessionID ||
+				!equalEscrowSnapshot(current.Snapshot, record.Snapshot) {
+				return ErrEscrowSessionMismatch
+			}
+			return nil
+		}
+		if channel.chanStatus != ChanStatusDefault {
+			return fmt.Errorf("channel is not in default state: %v", channel.chanStatus)
+		}
+		if _, err := escrowAuthorizerFromBucket(bucket); err != nil {
+			return err
+		}
+		encoded, err := encodeEscrowRecord(record)
+		if err != nil {
+			return err
+		}
+		channel.chanStatus |= ChanStatusEscrowLocked
+		if err := putOpenChannel(bucket, channel); err != nil {
+			return err
+		}
+		return bucket.Put(escrowRecordKey, encoded)
+	})
+}
+
+// PrepareEscrowParent atomically persists the only parent this channel may
+// sign. A byte-for-byte retry is idempotent, all other changes fail closed.
+func (c *OpenChannel) PrepareEscrowParent(sessionID [32]byte, parent []byte,
+	prevOuts []EscrowPrevOut, channelInputIndex uint32, txid chainhash.Hash) error {
+
+	return c.updateEscrow(func(channel *OpenChannel, bucket kvdb.RwBucket) error {
+		record, err := escrowRecordForSession(bucket, sessionID)
+		if err != nil {
+			return err
+		}
+		if record.Stage >= EscrowParentPrepared {
+			if bytes.Equal(record.ParentTx, parent) &&
+				equalEscrowPrevOuts(record.PrevOuts, prevOuts) &&
+				record.ChannelInputIndex == channelInputIndex && record.ParentTxID == txid {
+				return nil
+			}
+			return ErrEscrowMutation
+		}
+		record.Stage = EscrowParentPrepared
+		record.ParentTx = bytes.Clone(parent)
+		record.PrevOuts = cloneEscrowPrevOuts(prevOuts)
+		record.ChannelInputIndex = channelInputIndex
+		record.ParentTxID = txid
+		return putEscrowRecord(bucket, record)
+	})
+}
+
+// StoreEscrowPartial atomically records the public signing evidence before a
+// local partial signature is returned to a caller.
+//
+// The authorizer is the key the caller verified the authorization against; it
+// must still be the channel's enrolled key, so the check and the release of
+// the partial cannot straddle an enrollment change.
+func (c *OpenChannel) StoreEscrowPartial(sessionID [32]byte, authorizer [32]byte,
+	policyVersion uint32, localNonce, remoteNonce, localPartial []byte) error {
+	if len(localNonce) != 66 || len(remoteNonce) != 66 ||
+		len(localPartial) != 32 {
+
+		return errors.New("invalid escrow signing evidence length")
+	}
+	if policyVersion == 0 {
+		return errors.New("escrow partial requires an authorization policy")
+	}
+
+	return c.updateEscrow(func(channel *OpenChannel, bucket kvdb.RwBucket) error {
+		record, err := escrowRecordForSession(bucket, sessionID)
+		if err != nil {
+			return err
+		}
+		enrolled, err := escrowAuthorizerFromBucket(bucket)
+		if err != nil {
+			return err
+		}
+		if enrolled != authorizer {
+			return ErrEscrowAuthorizerLocked
+		}
+		if record.Stage == EscrowFinalized {
+			return nil
+		}
+		if record.Stage == EscrowParentSigned {
+			// A fresh in-memory MuSig2 attempt after a restart must use new
+			// nonces. Keep the latest complete public attempt as durable audit
+			// evidence while retaining the irreversible signed stage.
+			record.LocalPubNonce = bytes.Clone(localNonce)
+			record.RemotePubNonce = bytes.Clone(remoteNonce)
+			record.LocalPartialSig = bytes.Clone(localPartial)
+			record.PolicyVersion = policyVersion
+			return putEscrowRecord(bucket, record)
+		}
+		if record.Stage != EscrowParentPrepared {
+			return fmt.Errorf("parent has not been prepared")
+		}
+		record.Stage = EscrowParentSigned
+		record.LocalPubNonce = bytes.Clone(localNonce)
+		record.RemotePubNonce = bytes.Clone(remoteNonce)
+		record.LocalPartialSig = bytes.Clone(localPartial)
+		record.PolicyVersion = policyVersion
+		return putEscrowRecord(bucket, record)
+	})
+}
+
+// CancelEscrow removes the authorization and only its lock bit. Cancellation
+// is prohibited after a local partial signature has been persisted.
+func (c *OpenChannel) CancelEscrow(sessionID [32]byte) error {
+	return c.updateEscrow(func(channel *OpenChannel, bucket kvdb.RwBucket) error {
+		record, err := escrowRecordForSession(bucket, sessionID)
+		if errors.Is(err, ErrNoEscrowRecord) &&
+			bytes.Equal(bucket.Get(escrowCancellationKey), sessionID[:]) {
+
+			return nil
+		}
+
+		if err != nil {
+			return err
+		}
+		if record.Stage >= EscrowParentSigned || len(record.LocalPartialSig) != 0 {
+			return ErrEscrowAlreadySigned
+		}
+		channel.chanStatus &^= ChanStatusEscrowLocked
+		if err := putOpenChannel(bucket, channel); err != nil {
+			return err
+		}
+		if err := bucket.Put(escrowCancellationKey, sessionID[:]); err != nil {
+			return err
+		}
+		return bucket.Delete(escrowRecordKey)
+	})
+}
+
+// FinalizeEscrowInput atomically records the parent with its finalized channel
+// input witness, preserving the escrow lock for audit and exact-spend
+// classification. Other CoinJoin input witnesses may still be absent, so this
+// does not mark the transaction broadcast or schedule it for publication.
+func (c *OpenChannel) FinalizeEscrowInput(sessionID [32]byte, closeTx *wire.MsgTx) error {
+
+	if closeTx == nil {
+		return errors.New("nil escrow cooperative transaction")
+	}
+	var txBuf bytes.Buffer
+	if err := closeTx.Serialize(&txBuf); err != nil {
+		return err
+	}
+	return c.updateEscrow(func(channel *OpenChannel, bucket kvdb.RwBucket) error {
+		record, err := escrowRecordForSession(bucket, sessionID)
+		if err != nil {
+			return err
+		}
+		if record.Stage == EscrowFinalized {
+			if bytes.Equal(record.FinalTx, txBuf.Bytes()) {
+				return nil
+			}
+			return ErrEscrowMutation
+		}
+		if record.Stage != EscrowParentSigned {
+			return fmt.Errorf("parent has not been signed")
+		}
+		if closeTx.TxHash() != record.ParentTxID {
+			return ErrEscrowMutation
+		}
+		record.Stage = EscrowFinalized
+		record.FinalTx = txBuf.Bytes()
+		if err := putEscrowRecord(bucket, record); err != nil {
+			return err
+		}
+		channel.chanStatus |= ChanStatusEscrowLocked
+		return putOpenChannel(bucket, channel)
+	})
+}
+
+// EscrowAuthorizer returns the channel's enrolled BIP340 x-only authorizer.
+func (c *OpenChannel) EscrowAuthorizer() ([32]byte, error) {
+	var key [32]byte
+	err := kvdb.View(c.Db.backend, func(tx kvdb.RTx) error {
+		bucket, err := fetchChanBucket(
+			tx, c.IdentityPub, &c.FundingOutpoint, c.ChainHash,
+		)
+		if err != nil {
+			return err
+		}
+		key, err = escrowAuthorizerFromBucket(bucket)
+		return err
+	}, func() { key = [32]byte{} })
+	return key, err
+}
+
+// AuthorizeEscrow enrolls the channel for escrow under an authorizer key.
+// Re-enrolling the same key is idempotent at any time. A channel without an
+// authorizer may receive its first enrollment while an escrow record exists.
+// Changing an existing authorizer is refused while an escrow record exists.
+func (c *OpenChannel) AuthorizeEscrow(authorizer [32]byte) error {
+	return c.updateEscrow(func(channel *OpenChannel, bucket kvdb.RwBucket) error {
+		current, err := escrowAuthorizerFromBucket(bucket)
+		switch {
+		case err == nil && current == authorizer:
+			return nil
+		case err == nil:
+			if bucket.Get(escrowRecordKey) != nil {
+				return ErrEscrowAuthorizerLocked
+			}
+		case !errors.Is(err, ErrNoEscrowAuthorizer):
+			return err
+		}
+		encoded := make([]byte, 0, 33)
+		encoded = append(encoded, escrowAuthorizerVersion)
+		encoded = append(encoded, authorizer[:]...)
+		return bucket.Put(escrowAuthorizerKey, encoded)
+	})
+}
+
+// RevokeEscrowAuthorizer removes the channel's enrollment. It is refused while
+// an escrow record exists and is idempotent otherwise.
+func (c *OpenChannel) RevokeEscrowAuthorizer() error {
+	return c.updateEscrow(func(channel *OpenChannel, bucket kvdb.RwBucket) error {
+		if bucket.Get(escrowRecordKey) != nil {
+			return ErrEscrowAuthorizerLocked
+		}
+		if bucket.Get(escrowAuthorizerKey) == nil {
+			return nil
+		}
+		return bucket.Delete(escrowAuthorizerKey)
+	})
+}
+
+func escrowAuthorizerFromBucket(bucket kvdb.RBucket) ([32]byte, error) {
+	var key [32]byte
+	data := bucket.Get(escrowAuthorizerKey)
+	if data == nil {
+		return key, ErrNoEscrowAuthorizer
+	}
+	if len(data) != 33 || data[0] != escrowAuthorizerVersion {
+		return key, errors.New("unknown escrow authorizer record")
+	}
+	copy(key[:], data[1:])
+	return key, nil
+}
+
+func (c *OpenChannel) updateEscrow(f func(*OpenChannel, kvdb.RwBucket) error) error {
+	c.Lock()
+	defer c.Unlock()
+	var status ChannelStatus
+	err := kvdb.Update(c.Db.backend, func(tx kvdb.RwTx) error {
+		bucket, err := fetchChanBucketRw(tx, c.IdentityPub, &c.FundingOutpoint, c.ChainHash)
+		if err != nil {
+			return err
+		}
+		channel, err := fetchOpenChannel(bucket, &c.FundingOutpoint)
+		if err != nil {
+			return err
+		}
+		if err := f(channel, bucket); err != nil {
+			return err
+		}
+		status = channel.chanStatus
+		return nil
+	}, func() {})
+	if err == nil {
+		c.chanStatus = status
+	}
+	return err
+}
+
+func escrowRecordForSession(bucket kvdb.RBucket, sessionID [32]byte) (*EscrowRecord, error) {
+	data := bucket.Get(escrowRecordKey)
+	if data == nil {
+		return nil, ErrNoEscrowRecord
+	}
+	record, err := decodeEscrowRecord(data)
+	if err != nil {
+		return nil, err
+	}
+	if record.SessionID != sessionID {
+		return nil, ErrEscrowSessionMismatch
+	}
+	return record, nil
+}
+
+func putEscrowRecord(bucket kvdb.RwBucket, record *EscrowRecord) error {
+	encoded, err := encodeEscrowRecord(record)
+	if err != nil {
+		return err
+	}
+	return bucket.Put(escrowRecordKey, encoded)
+}
+
+func encodeEscrowRecord(record *EscrowRecord) ([]byte, error) {
+	if record == nil || record.Stage > EscrowFinalized {
+		return nil, errors.New("invalid escrow record")
+	}
+	var buf bytes.Buffer
+	buf.WriteByte(escrowEncodingVersion)
+	if err := binary.Write(&buf, binary.BigEndian, record.PolicyVersion); err != nil {
+		return nil, err
+	}
+	buf.Write(record.SessionID[:])
+	buf.WriteByte(byte(record.Stage))
+	if err := binary.Write(&buf, binary.BigEndian, record.Snapshot.Capacity); err != nil {
+		return nil, err
+	}
+	if err := binary.Write(&buf, binary.BigEndian, record.Snapshot.LocalClaim); err != nil {
+		return nil, err
+	}
+	if err := binary.Write(&buf, binary.BigEndian, record.Snapshot.RemoteClaim); err != nil {
+		return nil, err
+	}
+	buf.Write(record.Snapshot.PeerPubKey[:])
+	if err := writeEscrowBytes(&buf, record.Snapshot.FundingScript); err != nil {
+		return nil, err
+	}
+	buf.Write(record.Snapshot.LocalFunding[:])
+	buf.Write(record.Snapshot.RemoteFunding[:])
+	if err := writeEscrowBytes(&buf, record.ParentTx); err != nil {
+		return nil, err
+	}
+	if len(record.PrevOuts) > 1<<16 {
+		return nil, errors.New("too many escrow prevouts")
+	}
+	if err := binary.Write(&buf, binary.BigEndian, uint32(len(record.PrevOuts))); err != nil {
+		return nil, err
+	}
+	for _, prevOut := range record.PrevOuts {
+		if err := binary.Write(&buf, binary.BigEndian, prevOut.Value); err != nil {
+			return nil, err
+		}
+		if err := writeEscrowBytes(&buf, prevOut.PkScript); err != nil {
+			return nil, err
+		}
+	}
+	if err := binary.Write(&buf, binary.BigEndian, record.ChannelInputIndex); err != nil {
+		return nil, err
+	}
+	buf.Write(record.ParentTxID[:])
+	for _, field := range [][]byte{record.LocalPubNonce, record.RemotePubNonce, record.LocalPartialSig, record.FinalTx} {
+		if err := writeEscrowBytes(&buf, field); err != nil {
+			return nil, err
+		}
+	}
+	if buf.Len() > maxEscrowRecordSize {
+		return nil, errors.New("escrow record too large")
+	}
+	return buf.Bytes(), nil
+}
+
+func decodeEscrowRecord(data []byte) (*EscrowRecord, error) {
+	if len(data) > maxEscrowRecordSize {
+		return nil, errors.New("escrow record too large")
+	}
+	r := bytes.NewReader(data)
+	version, err := r.ReadByte()
+	if err != nil || version != escrowEncodingVersion {
+		return nil, errors.New("unknown escrow record version")
+	}
+	record := &EscrowRecord{}
+	if err := binary.Read(r, binary.BigEndian, &record.PolicyVersion); err != nil {
+		return nil, err
+	}
+	if _, err := io.ReadFull(r, record.SessionID[:]); err != nil {
+		return nil, err
+	}
+	stage, err := r.ReadByte()
+	if err != nil || EscrowStage(stage) > EscrowFinalized {
+		return nil, errors.New("invalid escrow stage")
+	}
+	record.Stage = EscrowStage(stage)
+	for _, value := range []*int64{&record.Snapshot.Capacity, &record.Snapshot.LocalClaim, &record.Snapshot.RemoteClaim} {
+		if err := binary.Read(r, binary.BigEndian, value); err != nil {
+			return nil, err
+		}
+	}
+	if _, err := io.ReadFull(r, record.Snapshot.PeerPubKey[:]); err != nil {
+		return nil, err
+	}
+	if record.Snapshot.FundingScript, err = readEscrowBytes(r); err != nil {
+		return nil, err
+	}
+	if _, err := io.ReadFull(r, record.Snapshot.LocalFunding[:]); err != nil {
+		return nil, err
+	}
+	if _, err := io.ReadFull(r, record.Snapshot.RemoteFunding[:]); err != nil {
+		return nil, err
+	}
+	if record.ParentTx, err = readEscrowBytes(r); err != nil {
+		return nil, err
+	}
+	var count uint32
+	if err := binary.Read(r, binary.BigEndian, &count); err != nil || count > 1<<16 {
+		return nil, errors.New("invalid escrow prevout count")
+	}
+	record.PrevOuts = make([]EscrowPrevOut, count)
+	for i := range record.PrevOuts {
+		if err := binary.Read(r, binary.BigEndian, &record.PrevOuts[i].Value); err != nil {
+			return nil, err
+		}
+		if record.PrevOuts[i].PkScript, err = readEscrowBytes(r); err != nil {
+			return nil, err
+		}
+	}
+	if err := binary.Read(r, binary.BigEndian, &record.ChannelInputIndex); err != nil {
+		return nil, err
+	}
+	if _, err := io.ReadFull(r, record.ParentTxID[:]); err != nil {
+		return nil, err
+	}
+	fields := []*[]byte{&record.LocalPubNonce, &record.RemotePubNonce, &record.LocalPartialSig, &record.FinalTx}
+	for _, field := range fields {
+		if *field, err = readEscrowBytes(r); err != nil {
+			return nil, err
+		}
+	}
+	if r.Len() != 0 {
+		return nil, errors.New("trailing escrow record data")
+	}
+	return record, nil
+}
+
+func writeEscrowBytes(w io.Writer, value []byte) error {
+	if len(value) > maxEscrowBlobSize {
+		return errors.New("escrow field too large")
+	}
+	if err := binary.Write(w, binary.BigEndian, uint32(len(value))); err != nil {
+		return err
+	}
+	_, err := w.Write(value)
+	return err
+}
+
+func readEscrowBytes(r io.Reader) ([]byte, error) {
+	var length uint32
+	if err := binary.Read(r, binary.BigEndian, &length); err != nil || length > maxEscrowBlobSize {
+		return nil, errors.New("invalid escrow field length")
+	}
+	value := make([]byte, length)
+	_, err := io.ReadFull(r, value)
+	return value, err
+}
+
+func equalEscrowSnapshot(a, b EscrowSnapshot) bool {
+	return a.Capacity == b.Capacity && a.LocalClaim == b.LocalClaim && a.RemoteClaim == b.RemoteClaim &&
+		a.PeerPubKey == b.PeerPubKey && bytes.Equal(a.FundingScript, b.FundingScript) &&
+		a.LocalFunding == b.LocalFunding && a.RemoteFunding == b.RemoteFunding
+}
+
+func equalEscrowPrevOuts(a, b []EscrowPrevOut) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i].Value != b[i].Value || !bytes.Equal(a[i].PkScript, b[i].PkScript) {
+			return false
+		}
+	}
+	return true
+}
+
+func cloneEscrowPrevOuts(prevOuts []EscrowPrevOut) []EscrowPrevOut {
+	cloned := make([]EscrowPrevOut, len(prevOuts))
+	for i := range prevOuts {
+		cloned[i] = EscrowPrevOut{Value: prevOuts[i].Value, PkScript: bytes.Clone(prevOuts[i].PkScript)}
+	}
+	return cloned
+}
diff --git a/channeldb/channel_escrow_test.go b/channeldb/channel_escrow_test.go
new file mode 100644
index 000000000..2a4c47364
--- /dev/null
+++ b/channeldb/channel_escrow_test.go
@@ -0,0 +1,331 @@
+package channeldb
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"testing"
+
+	"github.com/btcsuite/btcd/chaincfg/chainhash"
+	"github.com/btcsuite/btcd/wire"
+	"github.com/lightningnetwork/lnd/kvdb"
+	"github.com/stretchr/testify/require"
+)
+
+// testAuthorizer is an arbitrary enrolled key; channeldb does not verify
+// signatures, the RPC server does.
+var testAuthorizer = [32]byte{7, 7, 7}
+
+func testEscrowRecord() *EscrowRecord {
+	var sessionID [32]byte
+	copy(sessionID[:], bytes.Repeat([]byte{1}, len(sessionID)))
+
+	parent := wire.NewMsgTx(2)
+	parent.AddTxIn(&wire.TxIn{
+		PreviousOutPoint: wire.OutPoint{Hash: chainhash.Hash{2}, Index: 3},
+	})
+	parent.AddTxOut(&wire.TxOut{Value: 100, PkScript: []byte{0x51, 0x20, 1}})
+	var parentBytes bytes.Buffer
+	_ = parent.Serialize(&parentBytes)
+
+	return &EscrowRecord{
+		SessionID: sessionID,
+		Stage:     EscrowParentPrepared,
+		Snapshot: EscrowSnapshot{
+			Capacity:      1000,
+			LocalClaim:    600,
+			RemoteClaim:   400,
+			PeerPubKey:    [33]byte{2},
+			FundingScript: []byte{0x51, 0x20, 2},
+			LocalFunding:  [33]byte{3},
+			RemoteFunding: [33]byte{4},
+		},
+		ParentTx: parentBytes.Bytes(),
+		PrevOuts: []EscrowPrevOut{
+			{Value: 1000, PkScript: []byte{0x51, 0x20, 5}},
+		},
+		ChannelInputIndex: 0,
+		ParentTxID:        parent.TxHash(),
+		LocalPubNonce:     bytes.Repeat([]byte{6}, 66),
+		RemotePubNonce:    bytes.Repeat([]byte{7}, 66),
+		LocalPartialSig:   bytes.Repeat([]byte{8}, 32),
+		FinalTx:           []byte{},
+	}
+}
+
+func testLockedEscrowRecord() *EscrowRecord {
+	record := testEscrowRecord()
+	record.Stage = EscrowLocked
+	record.ParentTx = nil
+	record.PrevOuts = nil
+	record.ParentTxID = chainhash.Hash{}
+	record.LocalPubNonce = nil
+	record.RemotePubNonce = nil
+	record.LocalPartialSig = nil
+	return record
+}
+
+func TestEscrowRecordEncoding(t *testing.T) {
+	t.Parallel()
+
+	record := testEscrowRecord()
+	encoded, err := encodeEscrowRecord(record)
+	require.NoError(t, err)
+
+	decoded, err := decodeEscrowRecord(encoded)
+	require.NoError(t, err)
+	require.Equal(t, record, decoded)
+
+	record.ParentTx[0] ^= 1
+	record.PrevOuts[0].PkScript[0] ^= 1
+	record.Snapshot.FundingScript[0] ^= 1
+	require.NotEqual(t, record.ParentTx, decoded.ParentTx)
+	require.NotEqual(t, record.PrevOuts[0].PkScript, decoded.PrevOuts[0].PkScript)
+	require.NotEqual(t, record.Snapshot.FundingScript, decoded.Snapshot.FundingScript)
+
+	_, err = decodeEscrowRecord(append(encoded, 1))
+	require.Error(t, err)
+	_, err = decodeEscrowRecord(encoded[:len(encoded)-1])
+	require.Error(t, err)
+	corrupt := bytes.Clone(encoded)
+	corrupt[0]++
+	_, err = decodeEscrowRecord(corrupt)
+	require.Error(t, err)
+
+	oversized := testEscrowRecord()
+	oversized.ParentTx = make([]byte, maxEscrowBlobSize+1)
+	_, err = encodeEscrowRecord(oversized)
+	require.Error(t, err)
+
+	var oversizedLength [4]byte
+	binary.BigEndian.PutUint32(oversizedLength[:], maxEscrowBlobSize+1)
+	_, err = readEscrowBytes(bytes.NewReader(oversizedLength[:]))
+	require.Error(t, err)
+
+	oversizedRecord := testEscrowRecord()
+	oversizedRecord.ParentTx = make([]byte, maxEscrowBlobSize)
+	oversizedRecord.FinalTx = make([]byte, maxEscrowBlobSize)
+	_, err = encodeEscrowRecord(oversizedRecord)
+	require.Error(t, err)
+	_, err = decodeEscrowRecord(make([]byte, maxEscrowRecordSize+1))
+	require.Error(t, err)
+}
+
+func TestEscrowRecordDurableTransitions(t *testing.T) {
+	t.Parallel()
+
+	fullDB, err := MakeTestDB(t)
+	require.NoError(t, err)
+	channel := createTestChannel(t, fullDB.ChannelStateDB())
+	require.NoError(t, channel.AuthorizeEscrow(testAuthorizer))
+
+	record := testLockedEscrowRecord()
+	require.NoError(t, channel.LockEscrow(record))
+	require.True(t, channel.HasChanStatus(ChanStatusEscrowLocked))
+	record.Snapshot.FundingScript[0] ^= 1
+
+	reloaded, err := fullDB.ChannelStateDB().FetchChannel(channel.FundingOutpoint)
+	require.NoError(t, err)
+	persisted, err := reloaded.EscrowRecord()
+	require.NoError(t, err)
+	require.Equal(t, record.SessionID, persisted.SessionID)
+	require.NotEqual(t, record.Snapshot, persisted.Snapshot)
+	record.Snapshot.FundingScript[0] ^= 1
+
+	require.NoError(t, reloaded.LockEscrow(record))
+	other := testLockedEscrowRecord()
+	other.SessionID[0]++
+	require.ErrorIs(t, reloaded.LockEscrow(other), ErrEscrowSessionMismatch)
+
+	prepared := testEscrowRecord()
+	require.NoError(t, reloaded.PrepareEscrowParent(
+		prepared.SessionID, prepared.ParentTx, prepared.PrevOuts,
+		prepared.ChannelInputIndex, prepared.ParentTxID,
+	))
+	require.NoError(t, reloaded.PrepareEscrowParent(
+		prepared.SessionID, prepared.ParentTx, prepared.PrevOuts,
+		prepared.ChannelInputIndex, prepared.ParentTxID,
+	))
+	mutated := bytes.Clone(prepared.ParentTx)
+	mutated[len(mutated)-1] ^= 1
+	require.ErrorIs(t, reloaded.PrepareEscrowParent(
+		prepared.SessionID, mutated, prepared.PrevOuts,
+		prepared.ChannelInputIndex, prepared.ParentTxID,
+	), ErrEscrowMutation)
+
+	localNonce := bytes.Repeat([]byte{1}, 66)
+	remoteNonce := bytes.Repeat([]byte{2}, 66)
+	partial := bytes.Repeat([]byte{3}, 32)
+	require.NoError(t, reloaded.StoreEscrowPartial(
+		prepared.SessionID, testAuthorizer, 1, localNonce, remoteNonce, partial,
+	))
+	require.ErrorIs(t, reloaded.CancelEscrow(prepared.SessionID), ErrEscrowAlreadySigned)
+
+	freshLocalNonce := bytes.Repeat([]byte{4}, 66)
+	freshRemoteNonce := bytes.Repeat([]byte{5}, 66)
+	freshPartial := bytes.Repeat([]byte{6}, 32)
+	require.NoError(t, reloaded.StoreEscrowPartial(
+		prepared.SessionID, testAuthorizer, 1, freshLocalNonce, freshRemoteNonce,
+		freshPartial,
+	))
+	persisted, err = reloaded.EscrowRecord()
+	require.NoError(t, err)
+	require.Equal(t, freshLocalNonce, persisted.LocalPubNonce)
+	require.Equal(t, freshRemoteNonce, persisted.RemotePubNonce)
+	require.Equal(t, freshPartial, persisted.LocalPartialSig)
+
+	var parent wire.MsgTx
+	require.NoError(t, parent.Deserialize(bytes.NewReader(prepared.ParentTx)))
+	parent.TxIn[0].Witness = wire.TxWitness{bytes.Repeat([]byte{9}, 64)}
+	require.NoError(t, reloaded.FinalizeEscrowInput(prepared.SessionID, &parent))
+	require.False(t, reloaded.HasChanStatus(ChanStatusCoopBroadcasted))
+	_, err = reloaded.BroadcastedCooperative()
+	require.ErrorIs(t, err, ErrNoCloseTx)
+	require.NoError(t, reloaded.FinalizeEscrowInput(prepared.SessionID, &parent))
+	parent.TxOut[0].Value++
+	require.ErrorIs(
+		t, reloaded.FinalizeEscrowInput(prepared.SessionID, &parent),
+		ErrEscrowMutation,
+	)
+}
+
+func TestEscrowCancelAndStatusString(t *testing.T) {
+	t.Parallel()
+
+	fullDB, err := MakeTestDB(t)
+	require.NoError(t, err)
+	channel := createTestChannel(t, fullDB.ChannelStateDB())
+	require.NoError(t, channel.AuthorizeEscrow(testAuthorizer))
+	record := testLockedEscrowRecord()
+	require.NoError(t, channel.LockEscrow(record))
+	require.Contains(t, channel.ChanStatus().String(), "ChanStatusEscrowLocked")
+	require.NoError(t, channel.CancelEscrow(record.SessionID))
+	require.False(t, channel.HasChanStatus(ChanStatusEscrowLocked))
+	_, err = channel.EscrowRecord()
+	require.True(t, errors.Is(err, ErrNoEscrowRecord))
+}
+
+func TestEscrowCancellationReceipt(t *testing.T) {
+	t.Parallel()
+
+	fullDB, err := MakeTestDB(t)
+	require.NoError(t, err)
+	channel := createTestChannel(t, fullDB.ChannelStateDB())
+	require.NoError(t, channel.AuthorizeEscrow(testAuthorizer))
+	record := testLockedEscrowRecord()
+	// Absence alone is never a cancellation receipt.
+	require.ErrorIs(t, channel.CancelEscrow(record.SessionID), ErrNoEscrowRecord)
+	require.NoError(t, channel.LockEscrow(record))
+	require.NoError(t, channel.CancelEscrow(record.SessionID))
+	reloaded, err := fullDB.ChannelStateDB().FetchChannel(channel.FundingOutpoint)
+	require.NoError(t, err)
+	require.NoError(t, reloaded.CancelEscrow(record.SessionID))
+	require.ErrorIs(t, reloaded.LockEscrow(record), ErrEscrowSessionMismatch)
+
+	other := testLockedEscrowRecord()
+	other.SessionID[0] ^= 1
+	require.ErrorIs(t, reloaded.CancelEscrow(other.SessionID), ErrNoEscrowRecord)
+	require.NoError(t, reloaded.LockEscrow(other))
+	require.ErrorIs(t, reloaded.CancelEscrow(record.SessionID), ErrEscrowSessionMismatch)
+	require.True(t, reloaded.HasChanStatus(ChanStatusEscrowLocked))
+	current, err := reloaded.EscrowRecord()
+	require.NoError(t, err)
+	require.Equal(t, other.SessionID, current.SessionID)
+	require.NoError(t, reloaded.CancelEscrow(other.SessionID))
+	require.NoError(t, reloaded.CancelEscrow(other.SessionID))
+	// A receipt for a different epoch is not affirmative evidence.
+	require.ErrorIs(t, reloaded.CancelEscrow(record.SessionID), ErrNoEscrowRecord)
+}
+
+func TestEscrowAuthorizerEnrollment(t *testing.T) {
+	t.Parallel()
+
+	fullDB, err := MakeTestDB(t)
+	require.NoError(t, err)
+	channel := createTestChannel(t, fullDB.ChannelStateDB())
+	record := testLockedEscrowRecord()
+
+	// An unenrolled channel cannot be locked.
+	_, err = channel.EscrowAuthorizer()
+	require.ErrorIs(t, err, ErrNoEscrowAuthorizer)
+	require.ErrorIs(t, channel.LockEscrow(record), ErrNoEscrowAuthorizer)
+	require.False(t, channel.HasChanStatus(ChanStatusEscrowLocked))
+
+	other := [32]byte{8}
+	require.NoError(t, channel.AuthorizeEscrow(other))
+	require.NoError(t, channel.AuthorizeEscrow(testAuthorizer))
+	require.NoError(t, channel.AuthorizeEscrow(testAuthorizer))
+	require.NoError(t, channel.LockEscrow(record))
+
+	// While a record exists only the same key may be enrolled again.
+	require.NoError(t, channel.AuthorizeEscrow(testAuthorizer))
+	require.ErrorIs(t, channel.AuthorizeEscrow(other), ErrEscrowAuthorizerLocked)
+	require.ErrorIs(t, channel.RevokeEscrowAuthorizer(), ErrEscrowAuthorizerLocked)
+	key, err := channel.EscrowAuthorizer()
+	require.NoError(t, err)
+	require.Equal(t, testAuthorizer, key)
+
+	require.NoError(t, channel.CancelEscrow(record.SessionID))
+	require.NoError(t, channel.RevokeEscrowAuthorizer())
+	require.NoError(t, channel.RevokeEscrowAuthorizer())
+	_, err = channel.EscrowAuthorizer()
+	require.ErrorIs(t, err, ErrNoEscrowAuthorizer)
+
+	// A malformed enrollment is never read as a key.
+	require.NoError(t, channel.updateEscrow(func(_ *OpenChannel, bucket kvdb.RwBucket) error {
+		return bucket.Put(escrowAuthorizerKey, append([]byte{2}, testAuthorizer[:]...))
+	}))
+	_, err = channel.EscrowAuthorizer()
+	require.Error(t, err)
+	require.NotErrorIs(t, err, ErrNoEscrowAuthorizer)
+}
+
+func TestEscrowPartialBindsEnrolledAuthorizer(t *testing.T) {
+	t.Parallel()
+
+	fullDB, err := MakeTestDB(t)
+	require.NoError(t, err)
+	channel := createTestChannel(t, fullDB.ChannelStateDB())
+	require.NoError(t, channel.AuthorizeEscrow(testAuthorizer))
+	prepared := testEscrowRecord()
+	require.NoError(t, channel.LockEscrow(testLockedEscrowRecord()))
+	require.NoError(t, channel.PrepareEscrowParent(
+		prepared.SessionID, prepared.ParentTx, prepared.PrevOuts,
+		prepared.ChannelInputIndex, prepared.ParentTxID,
+	))
+	nonce := bytes.Repeat([]byte{1}, 66)
+	partial := bytes.Repeat([]byte{3}, 32)
+
+	require.Error(t, channel.StoreEscrowPartial(
+		prepared.SessionID, testAuthorizer, 0, nonce, nonce, partial,
+	))
+	require.ErrorIs(t, channel.StoreEscrowPartial(
+		prepared.SessionID, [32]byte{8}, 1, nonce, nonce, partial,
+	), ErrEscrowAuthorizerLocked)
+	persisted, err := channel.EscrowRecord()
+	require.NoError(t, err)
+	require.Equal(t, EscrowParentPrepared, persisted.Stage)
+
+	require.NoError(t, channel.StoreEscrowPartial(
+		prepared.SessionID, testAuthorizer, 1, nonce, nonce, partial,
+	))
+	persisted, err = channel.EscrowRecord()
+	require.NoError(t, err)
+	require.Equal(t, EscrowParentSigned, persisted.Stage)
+	require.Equal(t, uint32(1), persisted.PolicyVersion)
+}
+
+func TestEscrowUnknownRecordVersion(t *testing.T) {
+	t.Parallel()
+
+	record := testEscrowRecord()
+	record.PolicyVersion = 1
+	record.Stage = EscrowParentSigned
+	for _, version := range []byte{0, 2, 3, 0xff} {
+		encoded, err := encodeEscrowRecord(record)
+		require.NoError(t, err)
+		encoded[0] = version
+		_, err = decodeEscrowRecord(encoded)
+		require.Error(t, err)
+	}
+}
