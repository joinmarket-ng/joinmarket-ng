+// isEscrowCooperativeSpend applies the narrow cooperative-close exception for
+// a locked channel. An unsigned parent is never accepted, and matching is by
+// canonical non-witness transaction ID only.
+func isEscrowCooperativeSpend(record *channeldb.EscrowRecord,
+	spendTxID chainhash.Hash) bool {
+
