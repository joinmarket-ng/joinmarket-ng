+func testEscrowChannel(t *testing.T) (*channeldb.OpenChannel, []byte) {
+	t.Helper()
+
+	localKey, _ := btcec.PrivKeyFromBytes(bytes.Repeat([]byte{1}, 32))
+	remoteKey, _ := btcec.PrivKeyFromBytes(bytes.Repeat([]byte{2}, 32))
+	channel := &channeldb.OpenChannel{
+		ChanType:        channeldb.SimpleTaprootFeatureBit,
+		FundingOutpoint: wire.OutPoint{Hash: chainhash.Hash{3}, Index: 2},
+		Capacity:        btcutil.Amount(1000),
+		IdentityPub:     remoteKey.PubKey(),
+		LocalChanCfg: channeldb.ChannelConfig{
+			MultiSigKey: keychain.KeyDescriptor{PubKey: localKey.PubKey()},
+		},
+		RemoteChanCfg: channeldb.ChannelConfig{
+			MultiSigKey: keychain.KeyDescriptor{PubKey: remoteKey.PubKey()},
+		},
+		LocalCommitment: channeldb.ChannelCommitment{
+			LocalBalance:  600_000,
+			RemoteBalance: 400_000,
+		},
