+			MethodName: "AuthorizeChannel",
+			Handler:    _ChannelEscrow_AuthorizeChannel_Handler,
+		},
+		{
+			MethodName: "RevokeChannel",
+			Handler:    _ChannelEscrow_RevokeChannel_Handler,
+		},
+	},
+	Streams:  []grpc.StreamDesc{},
+	Metadata: "channelescrowrpc/channelescrow.proto",
+}
