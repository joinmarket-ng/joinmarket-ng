+func TestStatusReturnsRecoveryEvidence(t *testing.T) {
+	t.Parallel()
+
+	var sessionID input.MuSig2SessionID
+	sessionID[0] = 1
+	var localNonce [musig2.PubNonceSize]byte
+	localNonce[0] = 2
+	record := &channeldb.EscrowRecord{
+		Stage:           channeldb.EscrowParentSigned,
+		ParentTxID:      chainhash.Hash{3},
+		LocalPubNonce:   bytes.Repeat([]byte{4}, musig2.PubNonceSize),
+		RemotePubNonce:  bytes.Repeat([]byte{5}, musig2.PubNonceSize),
+		LocalPartialSig: bytes.Repeat([]byte{6}, input.MuSig2PartialSigSize),
+	}
+	attempt := &signAttempt{
+		signerSession: sessionID,
+		localNonce:    localNonce,
+	}
+
+	response := statusResponse(record, attempt)
+
+	require.Equal(t, uint32(channeldb.EscrowParentSigned), response.Stage)
+	require.Equal(t, record.ParentTxID[:], response.ParentTxid)
+	require.False(t, response.Finalized)
+	require.Equal(t, record.LocalPubNonce, response.DurableLocalPublicNonce)
+	require.Equal(t, record.RemotePubNonce, response.DurableRemotePublicNonce)
+	require.Equal(t, record.LocalPartialSig, response.DurableLocalPartialSignature)
+	require.Equal(t, sessionID[:], response.ActiveAttemptId)
+	require.Equal(t, localNonce[:], response.ActiveLocalPublicNonce)
+
+	record.Stage = channeldb.EscrowFinalized
+	record.FinalTx = []byte{7}
+	response = statusResponse(record, nil)
+	require.True(t, response.Finalized)
+	require.Equal(t, record.FinalTx, response.FinalizedParentTx)
+	require.Empty(t, response.ActiveAttemptId)
+}
