new file mode 100644
index 000000000..41bfcc081
--- /dev/null
+++ b/lnrpc/channelescrowrpc/authorization.go
@@ -0,0 +1,170 @@
+//go:build channelescrowrpc
+// +build channelescrowrpc
+
+package channelescrowrpc
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+
+	"github.com/btcsuite/btcd/btcec/v2/schnorr"
+	"github.com/btcsuite/btcd/chaincfg/chainhash"
+	"github.com/btcsuite/btcd/wire"
+	"github.com/lightningnetwork/lnd/channeldb"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// AuthorizationPolicyV1 requires a BIP340 signature by the channel's enrolled
+// authorizer over authorizationDigest for every released partial signature.
+const AuthorizationPolicyV1 uint32 = 1
+
+// authorizationTag domain-separates the authorization digest.
+var authorizationTag = []byte("JoinMarketNG/channel-escrow-auth/v1")
+
+// authorizationDigest commits to everything the local partial signature
+// authorizes: the policy, network, node, channel, session, the exact stored
+// parent bytes, its ordered spent outputs and the channel input index.
+// Integers are little-endian; hashes and txids are in internal byte order.
+func authorizationDigest(policy uint32, chain chainhash.Hash, node [33]byte,
+	op wire.OutPoint, record *channeldb.EscrowRecord) *chainhash.Hash {
+
+	var msg bytes.Buffer
+	var u32 [4]byte
+	var u64 [8]byte
+	binary.LittleEndian.PutUint32(u32[:], policy)
+	msg.Write(u32[:])
+	msg.Write(chain[:])
+	msg.Write(node[:])
+	msg.Write(op.Hash[:])
+	binary.LittleEndian.PutUint32(u32[:], op.Index)
+	msg.Write(u32[:])
+	msg.Write(record.SessionID[:])
+	parentHash := sha256.Sum256(record.ParentTx)
+	msg.Write(parentHash[:])
+	binary.LittleEndian.PutUint32(u32[:], uint32(len(record.PrevOuts)))
+	msg.Write(u32[:])
+	for _, prevOut := range record.PrevOuts {
+		binary.LittleEndian.PutUint64(u64[:], uint64(prevOut.Value))
+		msg.Write(u64[:])
+		binary.LittleEndian.PutUint32(u32[:], uint32(len(prevOut.PkScript)))
+		msg.Write(u32[:])
+		msg.Write(prevOut.PkScript)
+	}
+	binary.LittleEndian.PutUint32(u32[:], record.ChannelInputIndex)
+	msg.Write(u32[:])
+	return chainhash.TaggedHash(authorizationTag, msg.Bytes())
+}
+
+// verifyAuthorization checks a SignParent authorization against the enrolled
+// key and the persisted parent, returning the key it was verified against.
+func (s *Server) verifyAuthorization(channel *channeldb.OpenChannel, op wire.OutPoint,
+	record *channeldb.EscrowRecord, policy uint32, signature []byte) ([32]byte, error) {
+
+	var authorizer [32]byte
+	if policy != AuthorizationPolicyV1 {
+		return authorizer, status.Error(codes.InvalidArgument,
+			"unsupported escrow authorization policy")
+	}
+	if record.Stage < channeldb.EscrowParentPrepared || len(record.ParentTx) == 0 {
+		return authorizer, status.Error(codes.FailedPrecondition,
+			"prepared escrow parent required")
+	}
+	if len(signature) != schnorr.SignatureSize {
+		return authorizer, status.Error(codes.PermissionDenied,
+			"escrow authorization signature required")
+	}
+	authorizer, err := channel.EscrowAuthorizer()
+	if err != nil {
+		return authorizer, authorizerError(err)
+	}
+	digest := authorizationDigest(policy, s.cfg.ChainHash, s.cfg.LocalNodeKey(), op, record)
+	return authorizer, checkAuthorization(authorizer, digest, signature)
+}
+
+// checkAuthorization verifies a BIP340 signature by the enrolled key.
+func checkAuthorization(authorizer [32]byte, digest *chainhash.Hash, signature []byte) error {
+	pubKey, err := schnorr.ParsePubKey(authorizer[:])
+	if err != nil {
+		return status.Error(codes.FailedPrecondition, "invalid enrolled escrow authorizer")
+	}
+	sig, err := schnorr.ParseSignature(signature)
+	if err != nil || !sig.Verify(digest[:], pubKey) {
+		return status.Error(codes.PermissionDenied, "invalid escrow authorization signature")
+	}
+	return nil
+}
+
+func authorizerError(err error) error {
+	switch {
+	case errors.Is(err, channeldb.ErrNoEscrowAuthorizer):
+		return status.Error(codes.FailedPrecondition, err.Error())
+	case errors.Is(err, channeldb.ErrEscrowAuthorizerLocked):
+		return status.Error(codes.FailedPrecondition, err.Error())
+	}
+	return err
+}
+
+// PolicyInfo lists the authorization policies enforced by this node.
+func (s *Server) PolicyInfo(context.Context, *PolicyInfoRequest) (*PolicyInfoResponse, error) {
+	return &PolicyInfoResponse{SupportedPolicyVersions: []uint32{AuthorizationPolicyV1}}, nil
+}
+
+// AuthorizeChannel enrolls a SIMPLE_TAPROOT channel for escrow.
+func (s *Server) AuthorizeChannel(_ context.Context, req *AuthorizeChannelRequest) (
+	*AuthorizeChannelResponse, error) {
+
+	op, err := parseChannelPoint(req.GetChannelPoint())
+	if err != nil {
+		return nil, err
+	}
+	var authorizer [32]byte
+	if len(req.GetAuthorizerPubkey()) != len(authorizer) {
+		return nil, status.Error(codes.InvalidArgument, "32-byte x-only authorizer required")
+	}
+	if _, err := schnorr.ParsePubKey(req.GetAuthorizerPubkey()); err != nil {
+		return nil, status.Error(codes.InvalidArgument, "invalid authorizer public key")
+	}
+	copy(authorizer[:], req.GetAuthorizerPubkey())
+	channel, err := s.cfg.ChanStateDB.FetchChannel(*op)
+	if err != nil {
+		return nil, err
+	}
+	if !channel.ChanType.IsTaproot() {
+		return nil, status.Error(codes.FailedPrecondition, "channel is not SIMPLE_TAPROOT")
+	}
+	if err := channel.AuthorizeEscrow(authorizer); err != nil {
+		return nil, authorizerError(err)
+	}
+	return &AuthorizeChannelResponse{}, nil
+}
+
+// RevokeChannel removes a channel's escrow enrollment.
+func (s *Server) RevokeChannel(_ context.Context, req *RevokeChannelRequest) (
+	*RevokeChannelResponse, error) {
+
+	op, err := parseChannelPoint(req.GetChannelPoint())
+	if err != nil {
+		return nil, err
+	}
+	channel, err := s.cfg.ChanStateDB.FetchChannel(*op)
+	if err != nil {
+		return nil, err
+	}
+	if err := channel.RevokeEscrowAuthorizer(); err != nil {
+		return nil, authorizerError(err)
+	}
+	return &RevokeChannelResponse{}, nil
+}
+
+func parseChannelPoint(point *ChannelPoint) (*wire.OutPoint, error) {
+	if point == nil || len(point.GetFundingTxid()) != chainhash.HashSize {
+		return nil, status.Error(codes.InvalidArgument, "channel point is required")
+	}
+	var hash chainhash.Hash
+	copy(hash[:], point.GetFundingTxid())
+	return wire.NewOutPoint(&hash, point.GetOutputIndex()), nil
+}
