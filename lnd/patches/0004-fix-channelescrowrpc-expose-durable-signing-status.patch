From 5341c40d8b0b3338b538611dda7e3d939cf61a3c Mon Sep 17 00:00:00 2001
From: m0wer <m0wer@sgn.space>
Date: Sun, 16 Aug 2026 20:47:09 +0200
Subject: [PATCH] fix(channelescrowrpc): expose durable signing status

Return persisted public signing evidence, finalized parent bytes, and any active attempt so clients can reconcile crash boundaries safely.\n\nChangelog: Expose channel escrow signing evidence for restart recovery
---
 lnrpc/channelescrowrpc/channelescrow.pb.go    | 196 ++++++++++++------
 lnrpc/channelescrowrpc/channelescrow.proto    |   6 +
 .../channelescrow.swagger.json                |  24 +++
 lnrpc/channelescrowrpc/server.go              |  26 ++-
 lnrpc/channelescrowrpc/server_test.go         |  42 +++-
 5 files changed, 223 insertions(+), 71 deletions(-)

diff --git a/lnrpc/channelescrowrpc/channelescrow.pb.go b/lnrpc/channelescrowrpc/channelescrow.pb.go
index 02d3a8a..1535bf4 100644
--- a/lnrpc/channelescrowrpc/channelescrow.pb.go
+++ b/lnrpc/channelescrowrpc/channelescrow.pb.go
@@ -836,9 +836,15 @@ type StatusResponse struct {
 	sizeCache     protoimpl.SizeCache
 	unknownFields protoimpl.UnknownFields
 
-	Stage      uint32 `protobuf:"varint,1,opt,name=stage,proto3" json:"stage,omitempty"`
-	ParentTxid []byte `protobuf:"bytes,2,opt,name=parent_txid,json=parentTxid,proto3" json:"parent_txid,omitempty"`
-	Finalized  bool   `protobuf:"varint,3,opt,name=finalized,proto3" json:"finalized,omitempty"`
+	Stage                        uint32 `protobuf:"varint,1,opt,name=stage,proto3" json:"stage,omitempty"`
+	ParentTxid                   []byte `protobuf:"bytes,2,opt,name=parent_txid,json=parentTxid,proto3" json:"parent_txid,omitempty"`
+	Finalized                    bool   `protobuf:"varint,3,opt,name=finalized,proto3" json:"finalized,omitempty"`
+	DurableLocalPublicNonce      []byte `protobuf:"bytes,4,opt,name=durable_local_public_nonce,json=durableLocalPublicNonce,proto3" json:"durable_local_public_nonce,omitempty"`
+	DurableRemotePublicNonce     []byte `protobuf:"bytes,5,opt,name=durable_remote_public_nonce,json=durableRemotePublicNonce,proto3" json:"durable_remote_public_nonce,omitempty"`
+	DurableLocalPartialSignature []byte `protobuf:"bytes,6,opt,name=durable_local_partial_signature,json=durableLocalPartialSignature,proto3" json:"durable_local_partial_signature,omitempty"`
+	FinalizedParentTx            []byte `protobuf:"bytes,7,opt,name=finalized_parent_tx,json=finalizedParentTx,proto3" json:"finalized_parent_tx,omitempty"`
+	ActiveAttemptId              []byte `protobuf:"bytes,8,opt,name=active_attempt_id,json=activeAttemptId,proto3" json:"active_attempt_id,omitempty"`
+	ActiveLocalPublicNonce       []byte `protobuf:"bytes,9,opt,name=active_local_public_nonce,json=activeLocalPublicNonce,proto3" json:"active_local_public_nonce,omitempty"`
 }
 
 func (x *StatusResponse) Reset() {
@@ -894,6 +900,48 @@ func (x *StatusResponse) GetFinalized() bool {
 	return false
 }
 
+func (x *StatusResponse) GetDurableLocalPublicNonce() []byte {
+	if x != nil {
+		return x.DurableLocalPublicNonce
+	}
+	return nil
+}
+
+func (x *StatusResponse) GetDurableRemotePublicNonce() []byte {
+	if x != nil {
+		return x.DurableRemotePublicNonce
+	}
+	return nil
+}
+
+func (x *StatusResponse) GetDurableLocalPartialSignature() []byte {
+	if x != nil {
+		return x.DurableLocalPartialSignature
+	}
+	return nil
+}
+
+func (x *StatusResponse) GetFinalizedParentTx() []byte {
+	if x != nil {
+		return x.FinalizedParentTx
+	}
+	return nil
+}
+
+func (x *StatusResponse) GetActiveAttemptId() []byte {
+	if x != nil {
+		return x.ActiveAttemptId
+	}
+	return nil
+}
+
+func (x *StatusResponse) GetActiveLocalPublicNonce() []byte {
+	if x != nil {
+		return x.ActiveLocalPublicNonce
+	}
+	return nil
+}
+
